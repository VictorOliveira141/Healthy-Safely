<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dashboard | Healthy Safely</title>
  <meta name="description" content="Dashboard do Healthy Safely - Acompanhe seu progresso em saúde e bem-estar." />
  <meta name="keywords" content="saúde, bem-estar, dashboard, tarefas, programas" />
  <meta property="og:title" content="Dashboard | Healthy Safely" />
  <meta property="og:description" content="Acompanhe seu progresso, programas e tarefas — tudo em um só lugar." />
  <meta property="og:image" content="/imagem/Logo repaginado 2.webp" />
  <meta property="og:url" content="https://healthysafely.com/dashboard" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Healthy Safely" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/user/dashboard.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
</head>
<body>
  <%- include('../partials/header.ejs') %>
  <%
    const taskList = typeof tasks !== 'undefined' ? tasks : [];
    const tarefasHoje = taskList.filter(t => !t.completed).slice(0, 4);
  %>

  <main class="dashboard-main">
    <!--CABEÇALHO-->
    <section class="dashboard-cb" aria-label="Boas-vindas">
      <article class="welcome">
        <span class="title">
          Dashboard
        </span>
        <!--Apresentação-->
        <h1>Olá, <span style="color: var(--accent-color);"><%= nome ? nome.split(' ')[0] : 'Usuário' %></span> </h1>
        <p>Hoje vc tem <%= tarefasHoje.length %> tarefas pendentes</p>
        <p>Você já conseguiu concluir 12 Tarefas essa semana! Parabéns!🎉 </p>
      </article>

      <!--PROGRESSO-->
      <article class="dashboard-progress" aria-label="Progresso de hoje e da semana">
        <div class="progress-card">
          <div class="circular-progress">
              <span class="progress-value">80%</span>
          </div>
          <span class="progress-label">Hoje</span>
        </div>

        <div class="progress-card">
          <div class="circular-progress">
              <span class="progress-value">15%</span>
          </div>
          <span class="progress-label">Semana</span>
        </div>
      </article>
    </section>

    <!--TAREFAS-->
    <section class="dashboard-tasks">
        <article class="task-tabs">
          <button class="tab-btn active" onclick="showTasks('programadas')">
            Programadas
          </button>
          <button class="tab-btn" onclick="showTasks('livres')">
            Sem ordem
          </button>
          <button type="button" class="tab-action-btn">
            +
          </button>
          <a href="/tasks" class="tab-link">
            Ver todas -->
          </a>
        </article>
        
        <article class="task-content">
          <!--Tarefas com horário definido-->
          <div id="programadas" class="task-list active">
            <ul class="hs-pessoais-wrapper" role="list" aria-label="Tarefas de hoje">
              <% tarefasHoje.forEach((t, i) => { %>
                <li role="listitem">
                  <article class="hs-pessoal-card <%= t.completed ? 'concluida' : '' %>" aria-labelledby="tarefa-titulo-<%= i %>">
                   
                    <div class="hs-pessoal-left">
                      <div class="hs-pessoal-icon" aria-hidden="true">
                        <% if (t.categoria === 'sono') { %>
                          <i class="bi bi-moon-stars" aria-hidden="true"></i>
                        <% } else if (t.categoria === 'saude') { %>
                          <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                        <% } else if (t.categoria === 'exercicio' || t.categoria === 'atividade fisica') { %>
                          <i class="bi bi-bicycle" aria-hidden="true"></i>
                        <% } else if (t.categoria === 'alimentacao') { %>
                          <i class="bi bi-egg-fried" aria-hidden="true"></i>
                        <% } else { %>
                          <i class="bi bi-list" aria-hidden="true"></i>
                        <% } %>
                      </div>

                      <div class="hs-pessoal-info">
                        <p id="tarefa-titulo-<%= i %>" class="hs-pessoal-titulo">
                          <%= t.title %>
                        </p>

                        <div class="task-details">
                          <span class="task-badge categoria">
                            <i class="bi bi-tag" aria-hidden="true"></i>
                            <span class="visually-hidden">Categoria:</span>
                            <span aria-live="polite"><%= t.categoria || 'Geral' %></span>
                          </span>

                          <span class="task-badge">
                            <i class="bi bi-play-circle" aria-hidden="true"></i>
                            <time datetime="06:30">06:30</time>
                          </span>

                          <span class="task-badge limite">
                            <i class="bi bi-alarm" aria-hidden="true"></i>
                            <time datetime="22:00">22:00</time>
                          </span>
                        </div>
                      </div>
                    </div>
                      
                    <div class="hs-pessoal-right">
                      <% if (!t.completed) { %>
                        <a href="/tasks/concluir?id=<%= t._id %>"
                          class="hs-pessoal-btn"
                          role="button"
                          aria-label="Concluir: <%= t.title %>">
                          <i class="bi bi-check-circle" aria-hidden="true"></i>
                          Concluir
                        </a>
                        
                        <% } else { %>
                          <button class="hs-pessoal-btn" disabled aria-disabled="true">
                            <span aria-hidden="true">✓</span> <span class="visually-hidden">Concluída</span>
                          </button>
                          <% } %>
                    </div>
                  </article>
                </li>
              <% }) %>  
            </ul>
          </div>
          
          <!--Tarefas sem horário definido(por enquanto sem nenhuma tarefa)-->
          <div id="livres" class="task-list">
            <div class="hs-empty-state" aria-live="polite">
              <i class="bi bi-journal-plus" aria-hidden="true"></i>
              <p class="hs-empty-title">Nenhuma atividade pessoal hoje</p>
              <p class="hs-empty-subtitle">
                Adicione tarefas pessoais para acompanhar seu progresso diário.
              </p>
            </div>
          </div>
        </article>
    </section>
          
    <!-- ── ÁREAS DE SAÚDE ───────────────────────────────────── -->
    <section class="dashboard-footer" aria-labelledby="tit-cats">
      <header class="hs-section-header">
        <h2 class="hs-section-title" id="tit-cats">
          Áreas de Saúde
        </h2>
      </header>
      <nav class="hs-categorias" aria-label="Categorias">
        <a href="/sono" class="hs-categoria-link">
          <img src="/imagem/sono.webp" alt="" aria-hidden="true" />
          <span>Sono</span>
        </a>
        <a href="/saude-mental" class="hs-categoria-link">
          <img src="/imagem/saudemental.webp" alt="" aria-hidden="true" />
          <span>Saúde Mental</span>
        </a>
        <a href="/atividade-fisica" class="hs-categoria-link">
          <img src="/imagem/atf.webp" alt="" aria-hidden="true" />
          <span>Atividade Física</span>
        </a>
        <a href="/alimentacao" class="hs-categoria-link">
          <img src="/imagem/alimentacao.webp" alt="" aria-hidden="true" />
          <span>Alimentação</span>
        </a>
      </nav>
    </section>
  </main>


  <%- include('../partials/footer.ejs') %>

  <script src="/js/dashboard.js"></script>
  
<script>
function showTasks(type) {

    document.querySelectorAll('.task-list').forEach(el => {
        el.classList.remove('active');
    });

    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.classList.remove('active');
    });

    document.getElementById(type).classList.add('active');

    event.target.classList.add('active');
}
</script>
<style>
  .visually-hidden{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden;}
</style>
</body>
</html>
