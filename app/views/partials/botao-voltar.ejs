<button
  type="button"
  onclick="voltarPagina(this)"
  class="btn-voltar"
  data-voltar-para="<%= typeof voltarPara !== 'undefined' ? voltarPara : '' %>"
  aria-label="Voltar"
>
  <i class="bi bi-chevron-left"></i>
</button>

<style>
  .btn-voltar {
    font-size: 1.5rem;
    color: var(--fundoclaro);
    background: none;
    border: none;
    cursor: pointer;
    font-weight: 600;
    padding-bottom: 5px;
    border-radius: var(--border-radius);
    transition: background 0.15s;
  }

  .btn-voltar:hover {
    color: var(--botao-hover);
  }
</style>
<script>
 function voltarPagina(botao) {
  const voltarPara = botao?.dataset.voltarPara;

  if (voltarPara) {
    window.location.replace(voltarPara);
  } else if (window.history.length > 1) {
    window.history.back();
  } else {
    window.location.href = "/";
  }
}
</script>
