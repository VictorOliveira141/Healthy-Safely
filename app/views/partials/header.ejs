<link rel="stylesheet" href="/css/header.css" />
<link rel="stylesheet" href="/css/healthy-ai.css" />

<a href="#main-content" class="skip-link">Pular para o conteúdo</a>

<header class="site-header">

  <section class="header-container">

    <!-- ======= LOGO ======= -->
    <a
      href="/"
      class="header-logo"
      aria-label="Página inicial da Healthy Safely"
    >
      <img
        src="/imagem/1x/logozeko.webp"
        alt="Healthy Safely - Plataforma de hábitos saudáveis"
      />

      <span class="header-logo-text">Healthy Safely</span>
    </a>

    <!-- ======= AÇÕES DO USUÁRIO ======= -->
    <nav class="header-actions" aria-label="Ações do usuário">

      <% if (usuario) { %>

        <section class="user-menu cliente">
          
          <a href="/" class="links" aria-label="Início">
          <i data-lucide="house" aria-hidden="true"></i>
          </a>

          <a href="/tasks" class="links" aria-label="Tarefas">
          <i data-lucide="clipboard-check" aria-hidden="true"></i>
          </a>

          <a href="/historico" class="links" aria-label="Histórico">
          <i data-lucide="bar-chart-3" aria-hidden="true"></i>
          </a>

          <button id="healthyAiToggleMobile" aria-label="Assistente IA" class="icone-destaque healthy-ai-trigger">
          <i data-lucide="sparkles" class="icone-destaque" aria-hidden="true"></i>
          </button>

          <figure class="foto-perfil">
            <button type="button" class="profile-toggle" aria-expanded="false" aria-controls="profileDropdown">
              <img
                src="<%= usuario.foto_perfil ? usuario.foto_perfil : '/imagem/user.webp' %>"
                alt="Foto de perfil"
              />
            </button>
          </figure>

          <div class="user-menu-dropdown" id="profileDropdown" aria-label="Menu do usuário">
            <a href="/perfil">Perfil</a>
            <a href="/notificacoes">Notificações</a>
            <a href="/configuracoes">Configurações</a>
            <a href="/ajuda">Ajuda</a>
            <a href="/sair" class="logout-link">Sair</a>
          </div>

        </section>

      <% } else { %>

        <section class="logar-cadastrar">

          <a href="/login" aria-label="Entrar">
            <i class="bi bi-person-circle" aria-hidden="true"></i>
          </a>

          <a href="/login" class="abrir">Entrar</a>
          <span>|</span>
          <a href="/cadastro" class="abrir-cadastro">Cadastrar</a>

        </section>

      <% } %>

    </nav>
  </section>

  <script src="/js/darkmode.js"></script>
  <script src="/js/header-scroll.js"></script>
  <script src="/js/user-dropdown.js"></script>

</header>

<%- include('../partials/menu-inferior.ejs') %>