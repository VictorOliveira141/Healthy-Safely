<link rel="stylesheet" href="/css/menu-inferior.css">

<!-- Botão de acessibilidade -->
<button
  id="btnAcessibilidade"
  class="botao-acessibilidade"
  aria-label="Abrir opções de acessibilidade"
>
  <i data-lucide="accessibility"></i>
</button>

<div class="menu-acessibilidade" id="menuAcessibilidade">
  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="moon"></i>
      <span>Modo escuro</span>
    </div>

    <label class="toggle" aria-label="Ativar lembretes de tarefas">
      <input type="checkbox" checked id="toggleDarkMode" />
      <span class="slider-toggle"></span>
    </label>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="type"></i>
      <span>Aumentar fonte</span>
    </div>

    <button class="botao-fonte" id="aumentarFonte">A+</button>
    <button class="botao-fonte" id="diminuirFonte">A-</button>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="contrast"></i>
      <span>Alto contraste</span>
    </div>

    <label class="toggle">
      <input type="checkbox" id="toggleContraste" />
      <span class="slider-toggle"></span>
    </label>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="sparkles"></i>
      <span>Reduzir animações</span>
    </div>

    <label class="toggle">
      <input type="checkbox" id="toggleAnimacoes" />
      <span class="slider-toggle"></span>
    </label>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="volume-2"></i>
      <span>Leitor de tela</span>
    </div>

    <label class="toggle">
      <input type="checkbox" id="toggleLeitor" />
      <span class="slider-toggle"></span>
    </label>
  </div>
</div>

<!-- MENU INFERIOR-->
<nav role="navigation" class="menu-inferior" aria-label="Menu inferior">
  <section class="menu-container">

    <% if (usuario) { %>

      <a href="/" aria-label="Início">
      <i data-lucide="house" aria-hidden="true"></i>
      </a>

      <a href="/tasks" aria-label="Tarefas">
      <i data-lucide="clipboard-check" aria-hidden="true"></i>
      </a>

      <button id="healthyAiToggleMobile" aria-label="Assistente IA" class="icone-destaque healthy-ai-trigger">
      <i data-lucide="sparkles" class="icone-destaque" aria-hidden="true"></i>
      </button>

      <a href="/historico" aria-label="Histórico">
      <i data-lucide="bar-chart-3" aria-hidden="true"></i>
      </a>

      <div class="menu-mais">
        <button
        type="button"
        class="botao-menu-mais"
        id="botaoMenuMais"
        aria-label="Mais opções"
        aria-expanded="false"
        aria-controls="menuMaisOpcoes"
        >
        <i data-lucide="menu" aria-hidden="true"></i>
      </button>
      
      <div class="menu-mais-opcoes" id="menuMaisOpcoes">

        <a href="/configuracoes">
          <img src="../imagem/menu-inferior/settings.webp" alt="" width="35px" height="auto">
          <span>Configurações</span>
        </a>

        <a href="/assinatura">
          <img src="../imagem/menu-inferior/assinatura.webp" alt="" width="35px" height="auto">
          <span>Assinatura</span>
        </a>

        <a href="/notificacoes">
          <img src="../imagem/menu-inferior/message.webp" alt="" width="35px" height="auto">
          <span>Notificações</span>
        </a>

        <a href="/ajuda">
          <img src="../imagem/menu-inferior/help.webp" alt="" width="35px" height="auto">
          <span>Ajuda</span>
        </a>

           <!-- Sair -->

        <a href="/sair">

          <i data-lucide="log-out"></i>
          <span>
            Sair
          </span>

        </a>
      </div>

    <% } else { %>

      <a href="/" aria-label="Início">
      <i data-lucide="house" aria-hidden="true"></i>
      </a>

      <a href="/login" aria-label="Entrar">
      <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
      </a>

    <% } %>

  </section>
</nav>

<!-- Acessibilidade-->
<div class="menu-acessibilidade" id="menuAcessibilidade">
    <div class="acessibilidade-header">
      <button
      type="button"
      id="voltarAcessibilidade"
      class="botao-voltar-acessibilidade"
      aria-label="Voltar ao menu"
      >
      ←
    </button>
    
    <h3>Acessibilidade</h3>
  </div>


  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="moon"></i>
      <span>Modo escuro</span>
    </div>

    <label class="toggle" aria-label="Ativar lembretes de tarefas">
      <input type="checkbox" checked id="toggleDarkMode" />
      <span class="slider-toggle"></span>
    </label>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="type"></i>
      <span>Aumentar fonte</span>
    </div>

    <button class="botao-fonte" id="aumentarFonte">A+</button>
    <button class="botao-fonte" id="diminuirFonte">A-</button>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="contrast"></i>
      <span>Alto contraste</span>
    </div>

    <label class="toggle">
      <input type="checkbox" id="toggleContraste" />
      <span class="slider-toggle"></span>
    </label>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="sparkles"></i>
      <span>Reduzir animações</span>
    </div>

    <label class="toggle">
      <input type="checkbox" id="toggleAnimacoes" />
      <span class="slider-toggle"></span>
    </label>
  </div>

  <div class="menu-item">
    <div class="menu-item-esquerda">
      <i data-lucide="volume-2"></i>
      <span>Leitor de tela</span>
    </div>

    <label class="toggle">
      <input type="checkbox" id="toggleLeitor" />
      <span class="slider-toggle"></span>
    </label>
  </div>
</div>

<!-- HEALTHY AI-->
<aside class="healthy-ai-sidebar" id="healthyAiSidebar" aria-hidden="true">
    <section class="healthy-ai-panel">
       <article class="healthy-ai-header">
        <div>
          <h3 class="healthy-ai-title"> Healthy AI</h3>
          <p class="healthy-ai-subtitle">
            Assistente de hábitos e produtividade
          </p>
        </div>
        <button class="healthy-ai-close" id="healthyAiClose" aria-label="Fechar assistente">
          ✕
        </button>
      </article>

      <section class="healthy-ai-body" id="healthyAiBody" aria-live="polite">
        <div class="healthy-ai-message bot">
          <div class="healthy-ai-meta">Healthy AI</div>
          <p>Olá! Eu sou o assistente Healthy AI. Posso ajudar você a organizar tarefas, estabelecer hábitos saudáveis e acompanhar suas metas.</p>
        </div>
      </section>

      <article class="healthy-ai-footer">
        <form id="healthyAiForm" class="healthy-ai-form">
          <label class="sr-only" for="healthyAiInput">Digite sua mensagem</label>
          <textarea id="healthyAiInput" class="healthy-ai-input" rows="1" placeholder="Escreva sua pergunta..." autocomplete="off"></textarea>
          <button type="submit" class="healthy-ai-send">Enviar</button>
        </form>
      </article>
    </section>
</aside>

<script src="/js/features/healthy-ai.js"></script>
<script src="/js/features/acessibility.js"></script>
<script src="/js/features/open-menu.js"></script>