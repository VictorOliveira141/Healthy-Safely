<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>
    <%= dados.possuiConta ? "Confirmar Login" : "Concluir Cadastro" %> | Healthy Safely
  </title>
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/cadastro.css" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />
</head>

<body>
    <%- include('../partials/header.ejs') %>
   <main class="main">
    <section class="card">
        <section class="form-area">
            <!-- VINDO PELA PAGINA DE login-->
            <% if (dados.possuiConta) { %>
                <h1 class="form-title">
                    Confirmar acesso
                </h1>
                
                <p style="font-size: 1rem;">
                    Você está entrando com a conta abaixo.
                </p>
                
                <div class="google-card">
                    <% if (dados.foto_perfil) { %>
                        <img
                        src="https://lh3.googleusercontent.com/a/default-user"
                        class="google-avatar"
                        alt="Foto do Google">
                        <% } else { %>
                            <div class="google-avatar google-avatar--fallback">
                                <i class="bi bi-person-fill"></i>
                            </div>
                        <% } %>
                        
                        <div class="google-user-info">
                            <h2>
                                <%= dados.usuario.nome %>
                            </h2>
                            
                            <p>
                                <%= dados.email %>
                            </p>
                        </div>
                    </div>

                    
                    <article style="display: flex; flex-direction: row; gap: 15px;">
                    <form action="/google/confirmacao" method="POST">
                        <button
                        class="btn-primary"
                        type="submit">
                        Entrar
                        </button>
                    </form>

                    <form action="/google/cancelar" method="POST">
                        <button
                         class="btn-primary"
                         type="submit"
                         style="color: red;">
                         Cancelar
                        </button>
                    </form>
                    </article>
            

            <!-- Vindo pela pagina de cadastro-->
            <% } else { %>
                <h1 class="form-title">
                    Conclua seu cadastro
                </h1>
                <p class="small">
                    Encontramos sua conta Google.
                    Agora basta completar seu cadastro.
                </p>
                
                <% if (dados.foto_perfil) { %>
                    <img
                    src="<%= dados.foto_perfil %>"
                    class="google-avatar"
                    alt="Foto do Google">
                    <% } %>
                    
                    <form
                    action="/google/cadastro"
                    method="POST"
                    novalidate>
                    <section>
                        <label class="inputs">E-mail</label>

                        <input
                        type="email"
                        value="<%= valores.email %>"
                        disabled>
                    </section>

                    <section>
                        <label class="inputs">Nome</label>
                        <input
                        name="nome"
                        type="text"
                        value="<%= valores.nome %>">
                        <span class="msg-erro">
                        <%= msgErro.nome || '' %>
                        </span>
                    </section>

                    <section>
                        <label class="inputs">
                            Nome de Usuário
                        </label>
            
                        <input
                        name="nomeusuario"
                        type="text"
                        value="<%= valores.nomeusuario %>">

                        <span class="msg-erro">
                            <%= msgErro.nomeusuario || '' %>
                        </span>
                    </section>
                    
                    <section>
                        <label class="inputs">
                            Senha
                        </label>
                        <input
                        name="senha"
                        type="password">
                        
                        <span class="msg-erro">
                            <%= msgErro.senha || '' %>
                        </span>
                    </section>
                    
                    <section>
                        <label class="inputs">
                            Confirmar senha
                        </label>

                        <input
                        name="confirmarSenha"
                        type="password">
                        <span class="msg-erro">
                            <%= msgErro.confirmarSenha || '' %>
                        </span>
                    </section>
                    
                    <% if (msgErro.geral) { %>
                        <div class="msg-erro">
                            <%= msgErro.geral %>
                        </div>
                        <% } %>
                        <div class="actions">
                            <button
                            class="btn-primary"
                            type="submit">
                            Criar conta
                        </button>
                     </div>
                    </form>
                    <% } %>
                </section>
            </section>
        </main>
        
        <%- include('../partials/footer.ejs') %>
        <script src="/js/ver-senha.js"></script>
</body>
</html>