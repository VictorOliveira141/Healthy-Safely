<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Perfil | Healthy Safely</title>
    <meta
      name="description"
      content="Visualize e edite seu perfil no Healthy Safely"
    />
    <meta name="keywords" content="perfil, usuário, saúde, bem-estar" />
    <meta property="og:title" content="Perfil | Healthy Safely" />
    <meta
      property="og:description"
      content="Acesse seu perfil e gerencie suas informações pessoais no Healthy Safely."
    />
    <meta property="og:image" content="/imagem/Logo repaginado 2.webp" />
    <meta property="og:url" content="https://healthysafely.com/perfil" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Healthy Safely" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/perfil.css" />
    <link rel="icon" href="/imagem/Logo repaginado 2.webp" />

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#5BBF6A" />
  </head>
  <body>
    <%- include('../partials/header.ejs') %>
    <main id="main-content" class="perfil-corpo" tabindex="-1">
      <section class="perfil" aria-labelledby="perfil-nome">
        <figure class="foto-perfil">
          <img
            src="<%= usuario && usuario.foto_perfil ? usuario.foto_perfil : '/imagem/user.webp' %>"
            alt="Foto de perfil"
          />
          <label for="uploadFoto" class="camera-icon" title="Alterar foto">
            <i class="bi bi-camera-fill" aria-hidden="true"></i>
          </label>
          <input type="file" id="uploadFoto" accept="image/*" hidden />
        </figure>

        <section class="info-perfil">
          <p class="seguidores">
            <span>Seu perfil</span>
          </p>
          <h1 id="perfil-nome">
            <%= usuario && usuario.nome ? usuario.nome.split('
            ').slice(0,2).join(' ') : 'Usuário' %>
          </h1>
          <p>
            @<%= usuario && usuario.nomeusuario ? usuario.nomeusuario : '—' %>
          </p>

          <!---------     CONECTAR AO BANCO FUTURAMENTE     ------>
          <h2>
            Membro desde <%= usuario && usuario.data_cadastro ? new
            Date(usuario.data_cadastro).toLocaleDateString('pt-BR') : '—' %>
          </h2>
          <!---------                             ------>
        </section>
      </section>

      <!---------      CONECTAR AO BANCO FUTURAMENTE     ------>
      <section class="sequencia-semanal">
        <div class="sequencia-header">
          <h2>Sua sequência semanal</h2>
        </div>
        <div class="dias-semana">
          <div class="dia">
            <span>Seg</span>
            <div class="ativo"></div>
          </div>

          <div class="dia">
            <span>Ter</span>
            <div class="ativo"></div>
          </div>

          <div class="dia">
            <span>Qua</span>
            <div class="inativo"></div>
          </div>

          <div class="dia">
            <span>Qui</span>
            <div class="ativo"></div>
          </div>

          <div class="dia">
            <span>Sex</span>
            <div class="ativo"></div>
          </div>

          <div class="dia">
            <span>Sáb</span>
            <div class="ativo"></div>
          </div>

          <div class="dia">
            <span>Dom</span>
            <div class="inativo"></div>
          </div>
        </div>

        <p class="mensagem-sequencia">
          🎉 Parabéns! Você concluiu tarefas em 5 dias nesta semana.
        </p>
      </section>
      <!---------                             ------>

      <!-- Ações rápidas -->
      <section class="containers-gerais" aria-labelledby="sec-acoes">
        <h2 class="containers-gerais-titulo" id="sec-acoes">Acesso Rápido</h2>
        <nav
          role="navigation"
          class="item-container"
          aria-label="Ações do perfil"
        >
          <a href="/tasks"
            ><i data-lucide="clipboard-check" aria-hidden="true"></i> Minhas
            Tarefas</a
          >
          <a href="/assistente"
            ><i data-lucide="sparkles" aria-hidden="true"></i> Assistente
            IA(andamento)</a
          >
          <a href="/historico"
            ><i data-lucide="bar-chart-3" aria-hidden="true"></i>
            Histórico(andamento)</a
          >
          <a href="/notificacoes"
            ><i data-lucide="bell" aria-hidden="true"></i> Notificações</a
          >
          <a href="/configuracoes"
            ><i data-lucide="settings" aria-hidden="true"></i> Configurações</a
          >
          <a href="/privacidade"
            ><i data-lucide="shield" aria-hidden="true"></i> Privacidade</a
          >
          <a href="/ajuda"
            ><i data-lucide="help-circle" aria-hidden="true"></i> Ajuda</a
          >
          <a href="/sair" style="color: #dc2626">
            <i
              data-lucide="log-out"
              style="color: #dc2626"
              aria-hidden="true"
            ></i>
            Sair da conta
          </a>
        </nav>
      </section>
    </main>

    <%- include('../partials/footer.ejs') %>
  </body>
</html>
