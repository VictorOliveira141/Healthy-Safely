<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tarefas | Healthy Safely</title>
  <meta property="og:title" content="Tarefas | Healthy Safely" />
  <meta property="og:description" content="Organize suas tarefas de saúde, acompanhe seu progresso e conclua atividades no Healthy Safely." />
  <meta property="og:image" content="/imagem/Logo repaginado 2.webp" />
  <meta property="og:url" content="https://healthysafely.com/tasks" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Healthy Safely" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/user/tasks.css" />
  <link rel="stylesheet" href="/css/user/tasksmodal.css" />
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
</head>
<body>
<%- include('../../partials/header.ejs') %>

<main class="hs-tasks-main">
    <!-- HERO -->
    <section class="hs-page-head card-base">
        <section class="hs-page-head">
            <span class="hs-page-kicker">
                Tarefas
            </span>
            <h1>
                Organize sua rotina saudável
            </h1>
            <p>
                Pequenos hábitos diários geram grandes resultados. Crie tarefas,
                acompanhe seu progresso e mantenha sua rotina em dia.
            </p>
        </section>
    </section>

    <!-- MOTIVAÇÃO-->
    <section class="hs-motivation-grid">
        <!--card 1-->
        <article class="hs-info-card">
            <span class="hs-info-icon">
                📋
            </span>
            <section>
                <h2>Tarefas Restantes</h2>
                <p>
                    <%= tasks ? tasks.filter(t => !t.completed).length : 0 %>
                </p>
            </section>
        </article>

        <!--card 2-->
        <article class="hs-info-card">
            <span class="hs-info-icon">
                🎯
            </span>
            <section>
                <h2>Meta diária</h2>
                <p>
                    <%= tasks ? tasks.filter(t => t.completed).length : 0 %> / 5
                </p>

                <section class="hs-progress">
                    <section
                        class="hs-progress-bar"
                        style="width:<%= Math.min(((tasks ? tasks.filter(t => t.completed).length : 0)/5)*100,100)%>%">
                    </section>
                </section>
            </section>
        </article>

        <!--card 3-->
        <article class="hs-info-card">
            <span class="hs-info-icon">
                🔥
            </span>
            <section>
                <h2>Sequência</h2>
                <p>
                    <%= usuario.ofensive || 0 %> dias
                </p>
            </section>
        </article>
    </section>

    <!-- PESQUISA,FILTROS e + NOVA TAREFA -->
    <section class="hs-task-toolbar">
        <!-- barra de pesquisa -->
        <input
            type="search"
            id="searchTask"
            placeholder="Pesquisar tarefa..."
        >

        <!-- filtro -->
        <select id="filterStatus">
            <option value="today">
                Hoje
            </option>

            <option value="nextweek">
                Próxima semana
            </option>
        </select>

        <!-- categoria -->
        <select id="filterCategory">
            <option value="">
                Categoria
            </option>

            <option value="geral">
                Geral
            </option>

            <option value="saude">
                Saúde
            </option>

            <option value="sono">
                Sono
            </option>

            <option value="alimentacao">
                Alimentação
            </option>

            <option value="exercicio">
                Exercício
            </option>
        </select>

        <button id="btnNovaTarefa" class="hs-floating-add">
         <i class="bi bi-plus-lg"></i>
         Nova tarefa
        </button>
    </section>

    <!-- CONTAINER TAREFAS-->
    <section class="hs-tasks-container">
    <section class="hs-tasks-section">
        <header class="hs-section-header">
            <h2>
                Tarefas pendentes de hoje
            </h2>
            <span class="hs-section-count">
                <%= tasks ? tasks.filter(t => !t.completed).length : 0 %>
            </span>
        </header>

        <% if(!tasks || tasks.filter(t => !t.completed).length === 0){ %>
            <section class="hs-empty-state">
                <i class="bi bi-check2-circle"></i>
                <h3>
                    Nenhuma tarefa pendente
                </h3>
                <p>
                    Excelente! Você concluiu todas as tarefas.
                </p>
            </section>
        <% } else { %>
        <ul class="hs-user-tasks">
            <% tasks
                .filter(t => !t.completed)
                .forEach(tarefa => { %>
                <li>
                    <article class="hs-user-task-card">
                        <section class="hs-task-main">

                          <a
                                href="/tasks/concluir?id=<%= tarefa._id %>"
                                class="hs-task-btn"
                            >
                                <i class="bi bi-check-lg"></i>
                                
                          </a>

                            <section class="hs-task-icon">
                                <% if(tarefa.categoria === "saude"){ %>
                                    💊
                                <% } else if(tarefa.categoria === "sono"){ %>
                                    🌙
                                <% } else if(tarefa.categoria === "alimentacao"){ %>
                                    🥗
                                <% } else if(tarefa.categoria === "exercicio"){ %>
                                    💪
                                <% } else { %>
                                    📋
                                <% } %>
                            </section>

                            <section class="hs-task-info">
                                <h3>
                                    <%= tarefa.title %>
                                </h3>

                                <section class="hs-task-meta">
                                    <span class="hs-task-cat">
                                      <h4>Categoria:
                                        <%= tarefa.categoria %>
                                      </h4>
                                    </span>

                                    <% if(tarefa.data){ %>
                                        <span>
                                            <i class="bi bi-calendar3"></i>
                                            <%= tarefa.data %>
                                        </span>
                                    <% } %>

                                    <% if(tarefa.horario){ %>
                                        <span>
                                            <i class="bi bi-clock"></i>
                                            <%= tarefa.horario %>
                                        </span>
                                    <% } %>
                                </section>
                            </section>
                        </section>

                        <section class="hs-task-actions">
                            <a
                                href="/tasks/editar/<%= tarefa._id %>"
                                class="hs-task-edit"
                            >
                                <i class="bi bi-pencil"></i>

                            </a>

                            <form
                                action="/tasks/excluir/<%= tarefa._id %>"
                                method="POST"
                                onsubmit="return confirm('Excluir esta tarefa?')"
                            >
                                <button
                                    type="submit"
                                    class="hs-btn-excluir"
                                >
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </form>
                        </section>
                    </article>
                </li>
            <% }) %>
        </ul>
        <% } %>
    </section>
    </section>

    <!-- CATEGORIAS -->
    <section class="hs-tasks-section">
    <header class="hs-section-header">
            <h2>
                Explore conteúdos
            </h2>
            
        </header>

    <nav class="hs-categorias">
        <a href="/sono" class="hs-categoria-link">
            <img src="/imagem/sono.webp" alt="Sono">
            <span>Sono</span>
            <p>Aprenda hábitos para dormir melhor.</p>
        </a>

        <a href="/saude-mental" class="hs-categoria-link">
            <img src="/imagem/saudemental.webp" alt="Saúde Mental">
            <span>Saúde Mental</span>
            <p>Reduza estresse e ansiedade.</p>
        </a>

        <a href="/atividade-fisica" class="hs-categoria-link">
            <img src="/imagem/atf.webp" alt="Atividade Física">
            <span>Atividade Física</span>
            <p>Dicas para manter a rotina.</p>
        </a>

        <a href="/alimentacao" class="hs-categoria-link">
            <img src="/imagem/alimentacao.webp" alt="Alimentação">
            <span>Alimentação</span>
            <p>Melhore sua nutrição.</p>
        </a>
    </nav>
</section>

<%- include('../../partials/voltar-topo.ejs') %>


<!-- OVERLAY -->
<div class="hs-drawer-overlay" id="drawerOverlay">
    <!-- Drawer -->
    <aside class="hs-task-drawer" id="taskDrawer">
        <header class="hs-drawer-header">
            <section>
                <h2>Nova tarefa</h2>
                <p>
                    Organize sua rotina de forma simples.
                </p>
            </section>
            <button
                class="hs-close-drawer"
                id="closeDrawer"
                type="button"
            >
                <i class="bi bi-x-lg"></i>
            </button>
        </header>

        <form
            action="/tasks/criar"
            method="POST"
            class="hs-drawer-form"
        >
            <section class="hs-form-group">
                <label>Título</label>
                <input
                    type="text"
                    name="titulo"
                    required
                    maxlength="200"
                    placeholder="Ex.: Caminhar 30 minutos"
                >
            </section>

            <section class="hs-form-group">
                <label>Descrição</label>
                <textarea
                    rows="4"
                    name="descricao"
                    placeholder="Opcional..."
                ></textarea>
            </section>

            <section class="hs-form-group">
                <label>Categoria</label>
                <select name="categoria">
                    <option value="geral">📋 Geral</option>
                    <option value="saude">💊 Saúde</option>
                    <option value="sono">🌙 Sono</option>
                    <option value="alimentacao">🥗 Alimentação</option>
                    <option value="exercicio">💪 Exercício</option>
                </select>
            </section>

            <section class="hs-inline">
                <section class="hs-form-group">
                    <label>Data</label>
                    <input
                        type="date"
                        name="data"
                    >
                </section>

                <section class="hs-form-group">
                    <label>Horário</label>
                    <input
                        type="time"
                        name="horario"
                    >
                </section>
            </section>

            <section class="hs-form-group">
                <label>Repetição</label>
                <select name="repeticao">
                    <option value="once">
                        Apenas uma vez
                    </option>

                    <option value="daily">
                        Todos os dias
                    </option>

                    <option value="weekly">
                        Dias da semana
                    </option>
                </select>
            </section>

            <footer class="hs-drawer-footer">
                <button
                    type="button"
                    class="hs-btn-cancel"
                    id="cancelDrawer"
                >
                    Cancelar
                </button>

                <button
                    type="submit"
                    class="hs-btn-save"
                >
                    <i class="bi bi-plus-circle-fill"></i>

                    Salvar tarefa
                </button>
            </footer>
        </form>
    </aside>
</div>

</main>

<%- include('../../partials/footer.ejs') %>
<script src="/js/tarefas/tarefalocal.js"></script>
<script src="/js/tarefas/criartarefa.js"></script>
</body>
</html>
