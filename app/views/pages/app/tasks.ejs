<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Tarefas | Healthy Safely</title>
  <meta property="og:title" content="Tarefas | Healthy Safely" />
  <meta property="og:description" content="Organize suas tarefas de saúde, acompanhe seu progresso e conclua atividades no Healthy Safely." />
  <meta property="og:image" content="/imagem/Logo repaginado 2.webp" />
  <meta property="og:url" content="https://healthysafely.com/tasks" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Healthy Safely" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/app/tasks.css" />
  <link rel="stylesheet" href="/css/app/tasksmodal.css" />
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
</head>
<body class="tk-page" data-edit-mode="<%= modoEdicao ? 'true' : 'false' %>" data-edit-task-id="<%= taskToEdit ? taskToEdit._id : '' %>">

<%- include('../../partials/header.ejs') %>

<%
  /* ── Dados reais vindos do controller ─────────────────────────────── */
  const taskList = typeof tasks !== 'undefined' ? tasks : [];
  const hojeId = typeof diaHoje !== 'undefined' && diaHoje ? diaHoje : 'segunda';

  const dias = [
    { id: 'domingo', abrev: 'Dom', nome: 'Domingo' },
    { id: 'segunda', abrev: 'Seg', nome: 'Segunda-feira' },
    { id: 'terca',   abrev: 'Ter', nome: 'Terça-feira' },
    { id: 'quarta',  abrev: 'Qua', nome: 'Quarta-feira' },
    { id: 'quinta',  abrev: 'Qui', nome: 'Quinta-feira' },
    { id: 'sexta',   abrev: 'Sex', nome: 'Sexta-feira' },
    { id: 'sabado',  abrev: 'Sáb', nome: 'Sábado' },
  ];

  // Manhã, tarde e noite seguem o mesmo corte de horário do dashboard.
  const periodos = [
    { id: 'manha',       label: 'Manhã',          icon: 'bi-sun' },
    { id: 'tarde',       label: 'Tarde',          icon: 'bi-cloud-sun' },
    { id: 'noite',       label: 'Noite',          icon: 'bi-moon-stars' },
    { id: 'sem-horario', label: 'Durante o dia',  icon: 'bi-pin-angle' },
  ];
  const periodoDaTarefa = (t) => {
    if (!t.horario) return 'sem-horario';
    const h = String(t.horario).slice(0, 5);
    if (h < '12:00') return 'manha';
    if (h < '18:00') return 'tarde';
    return 'noite';
  };

  const nomesCategoria = {
    geral: 'Geral', saude: 'Saúde', sono: 'Sono',
    alimentacao: 'Alimentação', exercicio: 'Atividade física',
  };
  const iconesCategoria = {
    geral: 'bi-list-check', saude: 'bi-heart-pulse', sono: 'bi-moon-stars',
    alimentacao: 'bi-egg-fried', exercicio: 'bi-bicycle',
  };
  const chaveCategoria = (c) => (nomesCategoria[c] ? c : 'geral');
  const labelsRepeticao = { daily: 'Todos os dias', weekly: 'Toda semana', once: 'Uma vez' };

  // A conclusão é sempre registrada para o dia de hoje (regra existente).
  // Nos demais dias a tarefa aparece só para consulta.
  const concluidaNoDia = (t, diaId) => {
    if (diaId === hojeId) return !!t.completed;
    if (t.repeticao === 'daily') return false;
    return !!t.completed;
  };
  const plural = (n, um, varios) => n + ' ' + (n === 1 ? um : varios);
  const ordenar = (lista) => [...lista].sort((a, b) =>
    String(a.horario || '').localeCompare(String(b.horario || '')) || a._id - b._id);

  const flashAtual = typeof flash !== 'undefined' ? flash : null;
%>

<!-- Aviso de feedback (tarefa criada, editada, excluída, etc.) -->
<% if (flashAtual && flashAtual.msg) { %>
  <div id="flash-msg" class="hs-flash hs-flash--<%= flashAtual.tipo || 'info' %>" role="status" aria-live="polite">
    <%= flashAtual.msg %>
  </div>
<% } %>

<main class="tk" data-dia-hoje="<%= hojeId %>">

  <!-- CABEÇALHO -->
  <header class="tk-head">
    <div class="tk-head__text">
      <p class="tk-kicker"><i class="bi bi-list-check" aria-hidden="true"></i> Tarefas</p>
      <h1>Minha semana</h1>
      <p class="tk-head__sub">Escolha um dia para ver e organizar suas tarefas.</p>
    </div>
    <button type="button" class="tk-add" data-nova id="btnNovaTarefa">
      <i class="bi bi-plus-lg" aria-hidden="true"></i> Nova tarefa
    </button>
  </header>

  <!-- DIAS DA SEMANA -->
  <nav class="tk-week" aria-label="Dias da semana">
    <div class="tk-week__list" role="tablist" aria-label="Dias da semana">
      <% dias.forEach(d => {
        const qtd = taskList.filter(t => t.dias.includes(d.id)).length;
      %>
        <button type="button" role="tab"
                class="tk-daybtn<%= d.id === hojeId ? ' is-today' : '' %>"
                id="tab-<%= d.id %>" data-dia="<%= d.id %>"
                aria-controls="dia-<%= d.id %>"
                aria-selected="<%= d.id === hojeId ? 'true' : 'false' %>"
                tabindex="<%= d.id === hojeId ? '0' : '-1' %>">
          <span class="tk-daybtn__abbr"><%= d.abrev %></span>
          <span class="tk-daybtn__dot<%= qtd ? ' has-tasks' : '' %>" aria-hidden="true"></span>
          <span class="tk-sr"><%= d.nome %><%= d.id === hojeId ? ', hoje' : '' %>, <%= plural(qtd, 'tarefa', 'tarefas') %></span>
        </button>
      <% }) %>
    </div>
  </nav>

  <!-- BUSCA E FILTROS -->
  <section class="tk-tools" aria-label="Filtros">
    <label class="tk-search">
      <i class="bi bi-search" aria-hidden="true"></i>
      <span class="tk-sr">Pesquisar tarefa</span>
      <input type="search" id="searchTask" placeholder="Pesquisar tarefa..." autocomplete="off" />
    </label>

    <label class="tk-select">
      <span class="tk-sr">Categoria</span>
      <select id="filterCategory">
        <option value="">Todas as categorias</option>
        <option value="geral">Geral</option>
        <option value="saude">Saúde</option>
        <option value="sono">Sono</option>
        <option value="alimentacao">Alimentação</option>
        <option value="exercicio">Atividade física</option>
      </select>
    </label>

    <div class="tk-seg tk-seg--filter" role="group" aria-label="Mostrar">
      <button type="button" class="is-active" data-status="all" aria-pressed="true">Todas</button>
      <button type="button" data-status="pending" aria-pressed="false">Pendentes</button>
      <button type="button" data-status="completed" aria-pressed="false">Concluídas</button>
    </div>
  </section>

  <!-- PAINÉIS (um por dia) -->
  <div class="tk-panels">
    <% dias.forEach(d => {
      const doDia = ordenar(taskList.filter(t => t.dias.includes(d.id)));
      const feitas = doDia.filter(t => concluidaNoDia(t, d.id)).length;
      const ehHoje = d.id === hojeId;
      const pct = doDia.length ? Math.round((feitas / doDia.length) * 100) : 0;
    %>
      <section class="tk-day" id="dia-<%= d.id %>" role="tabpanel" aria-labelledby="tab-<%= d.id %>"
               data-dia="<%= d.id %>" data-hoje="<%= ehHoje ? '1' : '0' %>" <%= ehHoje ? '' : 'hidden' %>>

        <header class="tk-day__head">
          <div>
            <h2><%= d.nome %><% if (ehHoje) { %> <span class="tk-badge">Hoje</span><% } %></h2>
            <p class="tk-day__sum">
              <% if (doDia.length === 0) { %>
                Nenhuma tarefa neste dia
              <% } else if (ehHoje) { %>
                <%= feitas %> de <%= doDia.length %> <%= doDia.length === 1 ? 'tarefa concluída' : 'tarefas concluídas' %>
              <% } else { %>
                <%= plural(doDia.length, 'tarefa', 'tarefas') %>
              <% } %>
            </p>
          </div>
          <% if (ehHoje && doDia.length > 0) { %>
            <div class="tk-ring" role="img" aria-label="<%= pct %>% das tarefas de hoje concluídas">
              <svg viewBox="0 0 44 44" aria-hidden="true" focusable="false">
                <circle class="tk-ring__track" cx="22" cy="22" r="19" pathLength="100" />
                <circle class="tk-ring__value" cx="22" cy="22" r="19" pathLength="100" style="--p: <%= pct %>" />
              </svg>
              <span><%= pct %>%</span>
            </div>
          <% } %>
        </header>

        <% if (doDia.length === 0) { %>
          <!-- DIA SEM TAREFAS -->
          <div class="tk-blank">
            <span class="tk-blank__icon" aria-hidden="true"><i class="bi bi-flower1"></i></span>
            <h3><%= ehHoje ? 'Seu dia está livre' : 'Nada planejado para ' + d.nome.toLowerCase() %></h3>
            <p>Que tal criar um hábito leve? Pequenas tarefas já fazem diferença na rotina.</p>
            <button type="button" class="tk-add tk-add--solid" data-nova data-dia="<%= d.id %>">
              <i class="bi bi-plus-lg" aria-hidden="true"></i> Adicionar tarefa
            </button>
          </div>
        <% } else { %>

          <% periodos.forEach(p => {
            const lista = doDia.filter(t => periodoDaTarefa(t) === p.id);
            if (!lista.length) return;
          %>
            <section class="tk-period" data-period="<%= p.id %>">
              <h3 class="tk-period__title">
                <span class="tk-period__icon" aria-hidden="true"><i class="bi <%= p.icon %>"></i></span>
                <%= p.label %>
                <span class="tk-period__count"><%= lista.length %></span>
              </h3>

              <ul class="tk-list">
                <% lista.forEach(t => {
                  const cat = chaveCategoria(t.categoria);
                  const hora = t.horario ? String(t.horario).slice(0, 5) : '';
                  const feita = concluidaNoDia(t, d.id);
                  const podeMarcar = ehHoje;
                %>
                  <li class="tk-item<%= hora ? '' : ' tk-item--flex' %>"
                      data-status="<%= feita ? 'completed' : 'pending' %>"
                      data-title="<%= t.title %>"
                      data-cat="<%= cat %>"
                      data-id="<%= t._id %>"
                      data-descricao="<%= t.descricao || '' %>"
                      data-data="<%= t.data || '' %>"
                      data-horario="<%= hora %>"
                      data-repeticao="<%= t.repeticao || 'once' %>"
                      data-dia-semana="<%= t.dia_semana || '' %>">

                    <% if (hora) { %>
                      <time class="tk-time" datetime="<%= hora %>"><%= hora %></time>
                    <% } %>

                    <article class="tk-card<%= feita ? ' is-done' : '' %>">
                      <% if (podeMarcar) { %>
                        <%# Mesma rota de antes: /tasks/concluir alterna concluída/pendente %>
                        <a href="/tasks/concluir?id=<%= t._id %>" class="tk-check" role="button"
                           aria-pressed="<%= feita ? 'true' : 'false' %>"
                           aria-label="<%= feita ? 'Desfazer conclusão: ' : 'Concluir: ' %><%= t.title %>">
                          <i class="bi bi-check-lg" aria-hidden="true"></i>
                        </a>
                      <% } else { %>
                        <span class="tk-check is-locked" role="img"
                              aria-label="<%= feita ? 'Concluída' : 'Pendente' %>: <%= t.title %>. A conclusão é marcada no próprio dia."
                              title="A conclusão é marcada no próprio dia">
                          <i class="bi <%= feita ? 'bi-check-lg' : 'bi-clock' %>" aria-hidden="true"></i>
                        </span>
                      <% } %>

                      <div class="tk-card__body">
                        <h4 class="tk-card__title"><%= t.title %></h4>
                        <% if (t.descricao) { %><p class="tk-card__desc"><%= t.descricao %></p><% } %>
                        <p class="tk-card__meta">
                          <span class="tk-tag cat-<%= cat %>"><i class="bi <%= iconesCategoria[cat] %>" aria-hidden="true"></i> <%= nomesCategoria[cat] %></span>
                          <% if (t.repeticao && t.repeticao !== 'once') { %>
                            <span class="tk-rep"><i class="bi bi-arrow-repeat" aria-hidden="true"></i> <%= labelsRepeticao[t.repeticao] %></span>
                          <% } %>
                          <% if (feita) { %><span class="tk-rep tk-rep--ok">Concluída</span><% } %>
                        </p>
                      </div>

                      <div class="tk-card__actions">
                        <a href="/tasks/editar/<%= t._id %>" class="tk-icon-btn" data-editar aria-label="Editar: <%= t.title %>" title="Editar">
                          <i class="bi bi-pencil" aria-hidden="true"></i>
                        </a>
                        <button type="button" class="tk-icon-btn tk-icon-btn--danger" data-excluir aria-label="Excluir: <%= t.title %>" title="Excluir">
                          <i class="bi bi-trash3" aria-hidden="true"></i>
                        </button>
                      </div>
                    </article>
                  </li>
                <% }) %>
              </ul>
            </section>
          <% }) %>

          <!-- NENHUM RESULTADO NOS FILTROS -->
          <div class="tk-noresult" hidden>
            <i class="bi bi-funnel" aria-hidden="true"></i>
            <p>Nenhuma tarefa com esses filtros.</p>
            <button type="button" data-limpar>Limpar filtros</button>
          </div>
        <% } %>
      </section>
    <% }) %>
  </div>

  <!-- ÁREAS DE SAÚDE -->
  <section class="tk-areas" aria-labelledby="tk-areas-title">
    <h2 id="tk-areas-title">Explore conteúdos</h2>
    <nav class="tk-areas__grid" aria-label="Áreas de saúde">
      <a href="/sono" class="tk-area">
        <span class="tk-area__icon"><img src="/imagem/sono.webp" alt="" aria-hidden="true" /></span>
        <span class="tk-area__text"><strong>Sono</strong><small>Aprenda hábitos para dormir melhor.</small></span>
      </a>
      <a href="/saude-mental" class="tk-area">
        <span class="tk-area__icon"><img src="/imagem/saudemental.webp" alt="" aria-hidden="true" /></span>
        <span class="tk-area__text"><strong>Saúde Mental</strong><small>Reduza estresse e ansiedade.</small></span>
      </a>
      <a href="/atividade-fisica" class="tk-area">
        <span class="tk-area__icon"><img src="/imagem/atf.webp" alt="" aria-hidden="true" /></span>
        <span class="tk-area__text"><strong>Atividade Física</strong><small>Dicas para manter a rotina.</small></span>
      </a>
      <a href="/alimentacao" class="tk-area">
        <span class="tk-area__icon"><img src="/imagem/alimentacao.webp" alt="" aria-hidden="true" /></span>
        <span class="tk-area__text"><strong>Alimentação</strong><small>Melhore sua nutrição.</small></span>
      </a>
    </nav>
  </section>
</main>

<!-- Botão flutuante (mobile) -->
<button type="button" class="tk-fab" data-nova aria-label="Nova tarefa">
  <i class="bi bi-plus-lg" aria-hidden="true"></i>
</button>

<%- include('../../partials/voltar-topo.ejs') %>

<!-- FORMULÁRIO (nova tarefa / editar) -->
<div class="tk-sheet-overlay" id="drawerOverlay" aria-hidden="true">
  <div class="tk-sheet" id="taskDrawer" role="dialog" aria-modal="true" aria-labelledby="sheetTitle">
    <header class="tk-sheet__head">
      <div>
        <h2 id="sheetTitle">Nova tarefa</h2>
        <p id="sheetSub">Organize sua rotina de forma simples.</p>
      </div>
      <button type="button" class="tk-icon-btn" id="closeDrawer" aria-label="Fechar">
        <i class="bi bi-x-lg" aria-hidden="true"></i>
      </button>
    </header>

    <form action="/tasks/criar" method="POST" class="tk-form" id="taskForm" novalidate>
      <div class="tk-field">
        <label for="f-titulo">Título</label>
        <input type="text" id="f-titulo" name="titulo" maxlength="200" placeholder="Ex.: Caminhar 30 minutos" autocomplete="off" aria-describedby="err-titulo" />
        <p class="tk-error" id="err-titulo" role="alert" hidden></p>
      </div>

      <div class="tk-field">
        <label for="f-descricao">Descrição <span class="tk-opt">(opcional)</span></label>
        <textarea id="f-descricao" name="descricao" rows="3" placeholder="Algum detalhe que ajude a lembrar"></textarea>
      </div>

      <div class="tk-row">
        <div class="tk-field">
          <label for="f-categoria">Categoria</label>
          <select id="f-categoria" name="categoria">
            <option value="geral">Geral</option>
            <option value="saude">Saúde</option>
            <option value="sono">Sono</option>
            <option value="alimentacao">Alimentação</option>
            <option value="exercicio">Atividade física</option>
          </select>
        </div>
        <div class="tk-field">
          <label for="f-horario">Horário <span class="tk-opt">(opcional)</span></label>
          <input type="time" id="f-horario" name="horario" aria-describedby="err-horario" />
          <p class="tk-error" id="err-horario" role="alert" hidden></p>
        </div>
      </div>

      <fieldset class="tk-field tk-fieldset">
        <legend>Repetição</legend>
        <div class="tk-seg tk-seg--radio">
          <label><input type="radio" name="repeticao" value="once" /><span>Uma vez</span></label>
          <label><input type="radio" name="repeticao" value="daily" /><span>Todos os dias</span></label>
          <label><input type="radio" name="repeticao" value="weekly" checked /><span>Toda semana</span></label>
        </div>
      </fieldset>

      <fieldset class="tk-field tk-fieldset" id="diaGroup">
        <legend>Dia da semana</legend>
        <div class="tk-daychips">
          <% dias.forEach(d => { %>
            <label><input type="radio" name="dia_semana" value="<%= d.id %>" /><span><%= d.abrev %></span></label>
          <% }) %>
        </div>
        <p class="tk-error" id="err-dia_semana" role="alert" hidden></p>
      </fieldset>

      <details class="tk-more" id="moreOptions">
        <summary>Mais opções</summary>
        <div class="tk-field">
          <label for="f-data">Data <span class="tk-opt">(opcional)</span></label>
          <input type="date" id="f-data" name="data" aria-describedby="hint-data err-data" />
          <p class="tk-hint" id="hint-data">Em tarefas de uma vez, é o dia exato. Nas repetidas, é quando elas começam.</p>
          <p class="tk-error" id="err-data" role="alert" hidden></p>
        </div>
      </details>

      <footer class="tk-sheet__foot">
        <button type="button" class="tk-btn tk-btn--ghost" id="cancelDrawer">Cancelar</button>
        <button type="submit" class="tk-btn tk-btn--solid" id="saveTaskButton">
          <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
          <span id="saveTaskText">Salvar tarefa</span>
        </button>
      </footer>
    </form>
  </div>
</div>

<!-- CONFIRMAÇÃO DE EXCLUSÃO -->
<dialog class="tk-confirm" id="confirmDelete" aria-labelledby="confirmTitle">
  <form method="POST" id="deleteForm" action="">
    <span class="tk-confirm__icon" aria-hidden="true"><i class="bi bi-trash3"></i></span>
    <h2 id="confirmTitle">Excluir tarefa?</h2>
    <p id="confirmText">Essa ação não pode ser desfeita.</p>
    <div class="tk-confirm__actions">
      <button type="button" class="tk-btn tk-btn--ghost" id="cancelDelete">Cancelar</button>
      <button type="submit" class="tk-btn tk-btn--danger">Excluir</button>
    </div>
  </form>
</dialog>

<%- include('../../partials/footer.ejs') %>

<script>
  window.taskToEdit = <%- JSON.stringify(taskToEdit || null).replace(/</g, '\\u003c') %>;
</script>
<script src="/js/tasks/drawer.js"></script>
<script src="/js/tasks/gerenciar-tarefa.js"></script>

</body>
</html>
