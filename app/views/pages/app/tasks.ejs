<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Tarefas | Healthy Safely</title>
  <meta property="og:title" content="Tarefas | Healthy Safely" />
  <meta property="og:description" content="Organize suas tarefas de saúde, acompanhe seu progresso e conclua atividades no Healthy Safely." />
  <meta property="og:image" content="/imagem/Logo repaginado 2.webp" />
  <meta property="og:url" content="https://healthysafely.com/tasks" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Healthy Safely" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/app/tasks.css" />
  <link rel="stylesheet" href="/css/app/tasksmodal.css" />
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
</head>
<body data-edit-mode="<%= modoEdicao ? 'true' : 'false' %>" data-edit-task-id="<%= taskToEdit ? taskToEdit._id : '' %>">

<%- include('../../partials/header.ejs') %>

<%
  // ── Dados reais vindos do controller (sem valores fictícios) ──────────
  const taskList = typeof tasks !== 'undefined' ? tasks : [];
  const pendentes = taskList.filter(t => !t.completed);
  const concluidasCount = taskList.filter(t => t.completed).length;
  const metaDiaria = 5; // meta fixa já existente no produto
  const progressoMeta = Math.min((concluidasCount / metaDiaria) * 100, 100);

  const usuarioAtual = typeof usuario !== 'undefined' && usuario ? usuario : {};
  const pontosUsuario = usuarioAtual.pontos || 0;
  const nivelUsuario = usuarioAtual.nivel || 'iniciante';
  const sequenciaDias = usuarioAtual.ofensive || 0;

  const nivelInfo = {
    iniciante:     { label: 'Iniciante',     icon: 'bi-flower1' },
    intermediario: { label: 'Intermediário', icon: 'bi-lightning-charge-fill' },
    avancado:      { label: 'Avançado',      icon: 'bi-award-fill' },
    elite:         { label: 'Elite',         icon: 'bi-trophy-fill' },
  };
  const nivelAtual = nivelInfo[nivelUsuario] || nivelInfo.iniciante;

  const nomesCategoria = {
    geral: 'Geral',
    saude: 'Saúde',
    sono: 'Sono',
    alimentacao: 'Alimentação',
    exercicio: 'Atividade física',
  };
  const iconesCategoria = {
    geral: 'bi-list-task',
    saude: 'bi-heart-pulse',
    sono: 'bi-moon-stars',
    alimentacao: 'bi-egg-fried',
    exercicio: 'bi-bicycle',
  };

  const flashAtual = typeof flash !== 'undefined' ? flash : null;
%>

<!-- Aviso de feedback (tarefa criada, editada, excluída, etc.) -->
<% if (flashAtual && flashAtual.msg) { %>
  <div id="flash-msg" class="hs-flash hs-flash--<%= flashAtual.tipo || 'info' %>" role="status" aria-live="polite">
    <%= flashAtual.msg %>
  </div>
<% } %>

<main class="hs-tasks-main">
    <!-- HERO -->
    <section class="hs-page-head">
        <section class="hs-page-head-content">
            <span class="hs-page-kicker">
                <i class="bi bi-list-check" aria-hidden="true"></i>
                Tarefas
            </span>
            <h1>
                Organize sua rotina saudável
            </h1>
            <p>
                Pequenos hábitos diários geram grandes resultados. Crie tarefas,
                acompanhe seu progresso e mantenha sua rotina em dia.
            </p>
        </section>
    </section>

    <!-- MOTIVAÇÃO-->
    <section class="hs-motivation-grid">
        <!--card 1-->
        <article class="hs-info-card">
            <span class="hs-info-icon hs-info-icon--pendente" aria-hidden="true">
                <i class="bi bi-hourglass-split"></i>
            </span>
            <section>
                <h2>Tarefas Restantes</h2>
                <p>
                    <%= pendentes.length %>
                </p>
            </section>
        </article>

        <!--card 2-->
        <article class="hs-info-card">
            <span class="hs-info-icon hs-info-icon--meta" aria-hidden="true">
                <i class="bi bi-bullseye"></i>
            </span>
            <section>
                <h2>Meta diária</h2>
                <p>
                    <%= concluidasCount %> / <%= metaDiaria %>
                </p>

                <section class="hs-progress" role="img" aria-label="<%= Math.round(progressoMeta) %>% da meta diária concluída">
                    <section
                        class="hs-progress-bar"
                        style="width:<%= progressoMeta %>%">
                    </section>
                </section>
            </section>
        </article>

        <!--card 3-->
        <article class="hs-info-card">
            <span class="hs-info-icon hs-info-icon--streak" aria-hidden="true">
                <i class="bi bi-fire"></i>
            </span>
            <section>
                <h2>Sequência</h2>
                <p>
                    <%= sequenciaDias %> dia<%= sequenciaDias === 1 ? '' : 's' %>
                </p>
            </section>
        </article>
    </section>


    <!-- PESQUISA,FILTROS e + NOVA TAREFA -->
    <section class="hs-task-toolbar">
        <!-- barra de pesquisa -->
        <div class="hs-search-wrap">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input
                type="search"
                id="searchTask"
                placeholder="Pesquisar tarefa..."
            >
        </div>

        <!-- filtro -->
        <select id="filterStatus">
            <option value="all">
                Todas
            </option>

            <option value="today">
                Hoje
            </option>

            <option value="nextweek">
                Próxima semana
            </option>
        </select>

        <!-- categoria -->
        <select id="filterCategory">
            <option value="">
                Categoria
            </option>

            <option value="geral">
                Geral
            </option>

            <option value="saude">
                Saúde
            </option>

            <option value="sono">
                Sono
            </option>

            <option value="alimentacao">
                Alimentação
            </option>

            <option value="exercicio">
                Exercício
            </option>
        </select>

        <button id="btnNovaTarefa" class="hs-floating-add" type="button">
         <i class="bi bi-plus-lg" aria-hidden="true"></i>
         Nova tarefa
        </button>
    </section>

    <!-- CONTAINER TAREFAS-->
    <section class="hs-tasks-container">
    <section class="hs-tasks-section">
        <header class="hs-section-header">
            <h2>
                Tarefas pendentes de hoje
            </h2>
            <span class="hs-section-count">
                <%= pendentes.length %>
            </span>
        </header>

        <% if (pendentes.length === 0) { %>
            <section class="hs-empty-state">
                <i class="bi bi-check2-circle" aria-hidden="true"></i>
                <h3>
                    Nenhuma tarefa pendente
                </h3>
                <p>
                    <%= taskList.length > 0 ? 'Excelente! Você concluiu todas as tarefas.' : 'Cadastre sua primeira tarefa para começar.' %>
                </p>
            </section>
        <% } else { %>
                <ul class="hs-user-tasks">
                    <% pendentes.forEach(tarefa => { %>
                        <li>
                            <article
                                class="hs-user-task-card"
                                data-title="<%= tarefa.title %>"
                                data-category="<%= tarefa.categoria %>"
                                data-data="<%= tarefa.data || '' %>"
                                data-horario="<%= tarefa.horario || '' %>"
                                data-repeticao="<%= tarefa.repeticao || 'once' %>"
                                data-dia-semana="<%= tarefa.dia_semana || '' %>"
                            >
                                <span class="hs-task-accent hs-accent--<%= tarefa.categoria %>" aria-hidden="true"></span>

                                <section class="hs-task-main">
                                    <div class="hs-task-top">
                                        <div class="hs-task-left">
                                            <a href="/tasks/concluir?id=<%= tarefa._id %>" class="hs-task-btn" role="button" aria-label="Concluir: <%= tarefa.title %>">
                                                <i class="bi bi-check-lg" aria-hidden="true"></i>
                                            </a>

                                            <section class="hs-task-icon hs-icon--<%= tarefa.categoria %>" aria-hidden="true">
                                                <i class="bi <%= iconesCategoria[tarefa.categoria] || 'bi-list-task' %>"></i>
                                            </section>

                                            <h3><%= tarefa.title %></h3>
                                        </div>

                                        <div class="hs-top-actions">
                                            <button type="button" class="hs-toggle-details" aria-expanded="false" title="Mostrar detalhes">
                                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                            </button>
                                        </div>
                                    </div>

                                    <section class="hs-task-details">
                                        <% if (tarefa.descricao) { %>
                                            <p class="hs-task-desc"><%= tarefa.descricao %></p>
                                        <% } %>

                                        <section class="hs-task-meta">
                                            <span class="hs-task-cat">
                                                <i class="bi bi-tag" aria-hidden="true"></i>
                                                <%= nomesCategoria[tarefa.categoria] || 'Geral' %>
                                            </span>

                                            <span>
                                                <i class="bi bi-calendar3" aria-hidden="true"></i>
                                                <%= tarefa.data ? new Date(tarefa.data).toLocaleDateString('pt-BR') : '--/--/--' %>
                                            </span>

                                            <% if (tarefa.horario) { %>
                                                <span>
                                                    <i class="bi bi-clock" aria-hidden="true"></i>
                                                    <%= tarefa.horario %>
                                                </span>
                                            <% } %>

                                            <% if (tarefa.pontos) { %>
                                                <span>
                                                    <i class="bi bi-star-fill" aria-hidden="true"></i>
                                                    <%= tarefa.pontos %> pts
                                                </span>
                                            <% } %>

                                            <% if (tarefa.repeticao === 'daily') { %>
                                                <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Diária</span>
                                            <% } else if (tarefa.repeticao === 'weekly') { %>
                                                <span><i class="bi bi-arrow-repeat" aria-hidden="true"></i> Semanal · <%= tarefa.dia_semana || 'dia específico' %></span>
                                            <% } else { %>
                                                <span><i class="bi bi-calendar-check" aria-hidden="true"></i> Única</span>
                                            <% } %>
                                        </section>

                                        <section class="hs-detail-actions">
                                            <a href="/tasks/editar/<%= tarefa._id %>" class="hs-task-edit">
                                                <i class="bi bi-pencil" aria-hidden="true"></i>
                                                <span>Editar</span>
                                            </a>

                                            <form action="/tasks/excluir/<%= tarefa._id %>" method="POST" onsubmit="return confirm('Excluir esta tarefa?')">
                                                <button type="submit" class="hs-btn-excluir">
                                                    <i class="bi bi-trash3" aria-hidden="true"></i>
                                                    <span>Excluir</span>
                                                </button>
                                            </form>
                                        </section>
                                    </section>
                                </section>
                            </article>
                        </li>
                    <% }) %>
                </ul>
        <% } %>
    </section>
    </section>

    <!-- ÁREAS DE SAÚDE -->
    <section class="hs-tasks-section">
        <header class="hs-section-header">
            <h2>
                Explore conteúdos
            </h2>
        </header>

        <nav class="hs-categorias" aria-label="Áreas de saúde">
            <a href="/sono" class="hs-categoria-link">
                <span class="hs-categoria-icone">
                    <img src="/imagem/sono.webp" alt="" aria-hidden="true">
                </span>
                <span>Sono</span>
                <p>Aprenda hábitos para dormir melhor.</p>
            </a>

            <a href="/saude-mental" class="hs-categoria-link">
                <span class="hs-categoria-icone">
                    <img src="/imagem/saudemental.webp" alt="" aria-hidden="true">
                </span>
                <span>Saúde Mental</span>
                <p>Reduza estresse e ansiedade.</p>
            </a>

            <a href="/atividade-fisica" class="hs-categoria-link">
                <span class="hs-categoria-icone">
                    <img src="/imagem/atf.webp" alt="" aria-hidden="true">
                </span>
                <span>Atividade Física</span>
                <p>Dicas para manter a rotina.</p>
            </a>

            <a href="/alimentacao" class="hs-categoria-link">
                <span class="hs-categoria-icone">
                    <img src="/imagem/alimentacao.webp" alt="" aria-hidden="true">
                </span>
                <span>Alimentação</span>
                <p>Melhore sua nutrição.</p>
            </a>
        </nav>
    </section>

<%- include('../../partials/voltar-topo.ejs') %>

<!-- OVERLAY -->
<div class="hs-drawer-overlay" id="drawerOverlay">
    <!-- Drawer -->
    <aside class="hs-task-drawer" id="taskDrawer">
        <header class="hs-drawer-header">
            <section>
                <h2>Nova tarefa</h2>
                <p>
                    Organize sua rotina de forma simples.
                </p>
            </section>
            <button
                class="hs-close-drawer"
                id="closeDrawer"
                type="button"
                aria-label="Fechar"
            >
                <i class="bi bi-x-lg" aria-hidden="true"></i>
            </button>
        </header>

        <form
            action="/tasks/criar"
            method="POST"
            class="hs-drawer-form"
        >
            <section class="hs-form-group">
                <label>Título</label>
                <input
                    type="text"
                    name="titulo"
                    required
                    maxlength="200"
                    placeholder="Ex.: Caminhar 30 minutos"
                >
            </section>

            <section class="hs-form-group">
                <label>Descrição</label>
                <textarea
                    rows="4"
                    name="descricao"
                    placeholder="Opcional..."
                ></textarea>
            </section>

            <section class="hs-form-group">
                <label>Categoria</label>
                <select name="categoria">
                    <option value="geral">Geral</option>
                    <option value="saude">Saúde</option>
                    <option value="sono">Sono</option>
                    <option value="alimentacao">Alimentação</option>
                    <option value="exercicio">Exercício</option>
                </select>
            </section>

            <section class="hs-inline">
                <section class="hs-form-group">
                    <label>Data</label>
                    <input
                        type="date"
                        name="data"
                    >
                </section>

                <section class="hs-form-group">
                    <label>Horário</label>
                    <input
                        type="time"
                        name="horario"
                    >
                </section>
            </section>

            <section class="hs-form-group">
                <label>Repetição</label>
                <select name="repeticao" id="repeticaoTarefa">
                    <option value="once">
                        Apenas uma vez
                    </option>

                    <option value="daily">
                        Todos os dias
                    </option>

                    <option value="weekly">
                        Dia específico da semana
                    </option>
                </select>
            </section>

            <section class="hs-form-group" id="diaSemanaGroup" style="display:none;">
                <label>Dia da semana</label>
                <select name="dia_semana">
                    <option value="">Selecione</option>
                    <option value="segunda">Segunda-feira</option>
                    <option value="terca">Terça-feira</option>
                    <option value="quarta">Quarta-feira</option>
                    <option value="quinta">Quinta-feira</option>
                    <option value="sexta">Sexta-feira</option>
                    <option value="sabado">Sábado</option>
                    <option value="domingo">Domingo</option>
                </select>
            </section>

            <footer class="hs-drawer-footer">
                <button
                    type="button"
                    class="hs-btn-cancel"
                    id="cancelDrawer"
                >
                    Cancelar
                </button>

                <button
                    type="submit"
                    class="hs-btn-save"
                    id="saveTaskButton"
                >
                    <i class="bi bi-plus-circle-fill" aria-hidden="true"></i>
                    <span id="saveTaskText">Salvar tarefa</span>
                </button>
            </footer>
        </form>
    </aside>
</div>

</main>

<%- include('../../partials/footer.ejs') %>

<script>
  window.taskToEdit = <%- JSON.stringify(taskToEdit || null) %>;
</script>
<script src="/js/tasks/drawer.js"></script>
<script src="/js/tasks/gerenciar-tarefa.js"></script>

</body>
</html>