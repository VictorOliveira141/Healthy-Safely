<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>Progressão | Healthy Safely</title>
  <meta name="description" content="Acompanhe sua constância, suas metas e a evolução das suas tarefas no Healthy Safely." />
  <meta property="og:title" content="Progressão | Healthy Safely" />
  <meta property="og:description" content="Pequenos passos, grandes mudanças. Acompanhe sua evolução no Healthy Safely." />
  <meta property="og:image" content="/imagem/Logo repaginado 2.webp" />
  <meta property="og:url" content="https://healthysafely.com/historico" />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Healthy Safely" />
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/app/historico.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#5BBF6A" />
</head>
<body>
  <%- include('../../partials/header.ejs') %>

  <%
    const plural = (n, s, p) => n + ' ' + (n === 1 ? s : p);
    const temDados = !indisponivel && dados && dados.temHistorico;
    const pctDe = (feitas, previstas) => previstas > 0 ? Math.min(100, Math.round((feitas / previstas) * 100)) : 0;
    const metaDiariaOk = temDados && dados.metaDiaria.previstas > 0 && dados.metaDiaria.concluidas >= dados.metaDiaria.previstas;
    const metaSemanalOk = temDados && dados.metaSemanal.previstas > 0 && dados.metaSemanal.concluidas >= dados.metaSemanal.previstas;
    const mostrarPremium = temDados && dados.diasComConclusao >= 7;
    const ehPremium = plano === 'premium';
    const payload = temDados ? {
      usuarioId: usuarioId,
      hoje: dados.hoje,
      periodos: dados.periodos,
    } : null;
  %>

  <main class="pg" data-usuario="<%= usuarioId %>">

    <!-- CABEÇALHO -->
    <header class="pg-head">
      <h1>Sua progressão</h1>
      <p>Pequenos passos, grandes mudanças.</p>
    </header>

    <% if (indisponivel || !dados) { %>

      <!-- ERRO AO CARREGAR (ex.: banco ainda não atualizado) -->
      <section class="pg-card pg-state" role="alert">
        <span class="pg-state__icon" aria-hidden="true"><i class="bi bi-cloud-slash"></i></span>
        <h2>Não conseguimos carregar sua progressão agora</h2>
        <p>Tente novamente em alguns instantes. Suas tarefas e conclusões continuam salvas.</p>
        <a href="/historico" class="pg-cta">Tentar de novo</a>
      </section>

    <% } else if (!dados.temHistorico) { %>

      <!-- ESTADO INICIAL: SEM HISTÓRICO -->
      <section class="pg-card pg-state">
        <span class="pg-state__icon pg-state__icon--leaf" aria-hidden="true"><i class="bi bi-flower1"></i></span>
        <h2>Sua evolução começa com o primeiro passo.</h2>
        <p>Conforme você concluir suas tarefas, seus indicadores e gráficos serão preenchidos com seu progresso real.</p>
        <a href="/tasks" class="pg-cta">Ir para as tarefas</a>
      </section>

    <% } else { %>

      <!-- CONQUISTA EM DESTAQUE (só com condição real; pode ser dispensada) -->
      <% if (dados.conquista) { %>
        <section class="pg-banner" id="pgConquista" data-id="<%= dados.conquista.id %>" role="status" hidden>
          <span class="pg-banner__icon" aria-hidden="true"><i class="bi <%= dados.conquista.icone === 'flame' ? 'bi-fire' : 'bi-trophy-fill' %>"></i></span>
          <div class="pg-banner__text">
            <strong><%= dados.conquista.titulo %></strong>
            <p><%= dados.conquista.texto %></p>
          </div>
          <button type="button" class="pg-banner__close" id="pgConquistaFechar" aria-label="Dispensar aviso"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </section>
      <% } %>

      <!-- INDICADORES -->
      <section class="pg-stats" aria-label="Indicadores">
        <article class="pg-card pg-stat">
          <span class="pg-stat__icon" aria-hidden="true"><i class="bi bi-fire"></i></span>
          <p class="pg-stat__label">Sequência atual</p>
          <p class="pg-stat__value"><%= plural(dados.sequencia.atual, 'dia', 'dias') %></p>
          <p class="pg-stat__sub">Seu recorde: <%= plural(dados.sequencia.recorde, 'dia', 'dias') %></p>
        </article>

        <article class="pg-card pg-stat">
          <span class="pg-stat__icon" aria-hidden="true"><i class="bi bi-calendar2-check"></i></span>
          <p class="pg-stat__label">Dias ativos na semana</p>
          <p class="pg-stat__value"><%= dados.semana.diasAtivos %> de <%= dados.semana.totalDias %></p>
          <p class="pg-stat__sub">
            <% if (dados.semana.metaDiasAtivos > 0) { %>Meta: <%= plural(dados.semana.metaDiasAtivos, 'dia', 'dias') %><% } else { %>Sem tarefas previstas esta semana<% } %>
          </p>
        </article>
      </section>

      <div class="pg-grid">

        <!-- EVOLUÇÃO -->
        <section class="pg-card pg-evolucao" aria-labelledby="pg-evolucao-t">
          <header class="pg-card__head">
            <h2 id="pg-evolucao-t">Evolução das tarefas</h2>
            <div class="pg-seg" role="group" aria-label="Período do gráfico">
              <button type="button" class="pg-seg__btn is-active" data-periodo="7" aria-pressed="true">7 dias</button>
              <button type="button" class="pg-seg__btn" data-periodo="30" aria-pressed="false">30 dias</button>
            </div>
          </header>

          <div class="pg-chart" id="pgChart" role="group" aria-label="Tarefas concluídas por dia"></div>
          <noscript><p class="pg-muted">Ative o JavaScript para ver o gráfico de evolução.</p></noscript>

          <dl class="pg-metrics">
            <div><dt>Concluídas</dt><dd id="pgTotal">–</dd></div>
            <div><dt>Dias ativos</dt><dd id="pgAtivos">–</dd></div>
            <div><dt>Taxa de conclusão</dt><dd id="pgTaxa">–</dd></div>
          </dl>
          <p class="pg-compare" id="pgComparacao" hidden></p>
        </section>

        <!-- METAS -->
        <section class="pg-card pg-metas" aria-labelledby="pg-metas-t">
          <header class="pg-card__head">
            <h2 id="pg-metas-t"><i class="bi bi-bullseye" aria-hidden="true"></i> Suas metas</h2>
          </header>

          <div class="pg-meta">
            <div class="pg-meta__row">
              <span>Meta diária</span>
              <% if (dados.metaDiaria.previstas > 0) { %><strong><%= dados.metaDiaria.concluidas %>/<%= dados.metaDiaria.previstas %></strong><% } %>
            </div>
            <% if (dados.metaDiaria.previstas > 0) { %>
              <div class="pg-bar" role="img" aria-label="<%= pctDe(dados.metaDiaria.concluidas, dados.metaDiaria.previstas) %>% da meta diária"><span style="width: <%= pctDe(dados.metaDiaria.concluidas, dados.metaDiaria.previstas) %>%"></span></div>
              <% if (metaDiariaOk) { %><p class="pg-meta__ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Meta de hoje concluída</p><% } %>
            <% } else { %>
              <p class="pg-muted">Sem tarefas previstas para hoje.</p>
            <% } %>
          </div>

          <div class="pg-meta">
            <div class="pg-meta__row">
              <span>Meta semanal</span>
              <% if (dados.metaSemanal.previstas > 0) { %><strong><%= dados.metaSemanal.concluidas %>/<%= dados.metaSemanal.previstas %></strong><% } %>
            </div>
            <% if (dados.metaSemanal.previstas > 0) { %>
              <div class="pg-bar" role="img" aria-label="<%= pctDe(dados.metaSemanal.concluidas, dados.metaSemanal.previstas) %>% da meta semanal"><span style="width: <%= pctDe(dados.metaSemanal.concluidas, dados.metaSemanal.previstas) %>%"></span></div>
              <% if (metaSemanalOk) { %><p class="pg-meta__ok"><i class="bi bi-check-circle-fill" aria-hidden="true"></i> Meta da semana concluída</p><% } %>
            <% } else { %>
              <p class="pg-muted">Sem tarefas previstas para esta semana.</p>
            <% } %>
          </div>

          <p class="pg-footnote">Suas metas vêm da sua rotina: as tarefas previstas para o dia e para a semana.</p>
        </section>
      </div>

      <!-- PREMIUM (só quando já existe histórico suficiente) -->
      <% if (mostrarPremium) { %>
        <section class="pg-card pg-premium" aria-labelledby="pg-premium-t">
          <header class="pg-premium__head">
            <span class="pg-premium__lock" aria-hidden="true"><i class="bi <%= ehPremium ? 'bi-stars' : 'bi-lock-fill' %>"></i></span>
            <div>
              <h2 id="pg-premium-t">Descubra sua evolução <span class="pg-pill">Premium</span></h2>
              <p>Compare seus resultados, explore gráficos avançados e receba um relatório personalizado sobre sua constância.</p>
            </div>
          </header>

          <ul class="pg-premium__list">
            <li>
              <i class="bi bi-graph-up-arrow" aria-hidden="true"></i>
              <span><strong>Análises avançadas</strong><small>Tendências de longo prazo, comparações entre semanas e meses e evolução por categoria.</small></span>
              <% if (!ehPremium) { %><i class="bi bi-lock-fill pg-premium__cadeado" aria-label="Recurso Premium"></i><% } %>
            </li>
            <li>
              <i class="bi bi-robot" aria-hidden="true"></i>
              <span><strong>Relatório semanal com IA</strong><small>Pontos fortes e oportunidades de melhoria com base nas suas conclusões.</small></span>
              <% if (!ehPremium) { %><i class="bi bi-lock-fill pg-premium__cadeado" aria-label="Recurso Premium"></i><% } %>
            </li>
          </ul>

          <% if (ehPremium) { %>
            <p class="pg-muted">Esses recursos estão em desenvolvimento e fazem parte do seu plano Premium.</p>
          <% } else { %>
            <a href="/assinatura" class="pg-cta pg-cta--block">Conhecer o Premium</a>
          <% } %>
        </section>
      <% } %>

      <!-- HISTÓRICO -->
      <section class="pg-card pg-historico" aria-labelledby="pg-hist-t">
        <header class="pg-card__head">
          <h2 id="pg-hist-t">Histórico</h2>
          <span class="pg-muted" id="pgHistoricoPeriodo">Últimos 7 dias</span>
        </header>

        <ol class="pg-hist-lista" id="pgHistLista">
          <% historico.forEach(dia => { %>
            <li class="pg-hist-dia" data-dia="<%= dia.dia %>">
              <div class="pg-hist-dia__top">
                <strong><%= new Date(dia.dia + 'T12:00:00').toLocaleDateString('pt-BR', { weekday: 'long', day: '2-digit', month: 'long' }) %></strong>
                <span><i class="bi bi-check-circle-fill" aria-hidden="true"></i> <%= plural(dia.total, 'tarefa concluída', 'tarefas concluídas') %></span>
              </div>
              <p><%= dia.titulos.join(' · ') %></p>
            </li>
          <% }) %>
        </ol>
        <p class="pg-muted pg-hist-vazio" id="pgHistVazio" hidden>Nenhuma tarefa concluída neste período.</p>
      </section>

      <script type="application/json" id="pgData"><%- JSON.stringify(payload).replace(/</g, '\\u003c') %></script>
    <% } %>
  </main>

  <%- include('../../partials/footer.ejs') %>

  <% if (temDados) { %><script src="/js/app/progressao.js"></script><% } %>
</body>
</html>
