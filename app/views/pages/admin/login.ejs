<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Admin — Healthy Safely</title>
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
  <link rel="stylesheet" href="/css/admin/login.css" />
  <link rel="stylesheet" href="/css/global.css" />
</head>

<body>
  <main class="admin-login">
    <div class="logo-wrap">
      <img src="/imagem/Logo repaginado 2.webp" alt="Healthy Safely" />
    </div>

    <span class="badge-admin">Área administrativa</span>
    <h1>Acesso restrito</h1>
    <p class="description">
      Entre com a credencial administrativa para acessar o painel do Healthy Safely.
    </p>

    <% if (erro) { %>
      <div class="erro-msg" role="alert"><%= erro %></div>
    <% } %>

    <form action="/admin" method="POST">
      <div class="campo">
        <label for="senha">Senha administrativa</label>
        <input
          id="senha"
          name="senha"
          type="password"
          autocomplete="current-password"
          required
          autofocus
        />
      </div>

      <button class="btn-entrar" type="submit">Entrar no painel</button>
    </form>

    <a class="voltar-link" href="/">Voltar para o Healthy Safely</a>
  </main>

</body>
</html>
