<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Painel Admin — Healthy Safely</title>
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/admin/painel.css" />
  <link rel="stylesheet" href="/css/global.css"> 
</head>

<body>
  <%- include('../../partials/admin-header.ejs', { activePage: 'painel' }) %>

  <main class="admin-main">
    <article class="page-heading">
      <div>
        <span class="eyebrow">Visão geral</span>
        <h1>Painel administrativo</h1>
        <p>Acompanhe o estado atual da plataforma sem informações desnecessárias.</p>
      </div>
    </article>

    <section class="metrics" aria-label="Resumo da plataforma">
      <article class="metric-card">
        <div class="metric-icon"><i class="bi bi-people-fill"></i></div>
        <div>
          <span class="metric-label">Usuários</span>
          <strong><%= stats.total_usuarios %></strong>
        </div>
      </article>

      <article class="metric-card">
        <div class="metric-icon"><i class="bi bi-person-plus-fill"></i></div>
        <div>
          <span class="metric-label">Novos em 7 dias</span>
          <strong><%= stats.novos_7_dias %></strong>
        </div>
      </article>

      <article class="metric-card">
        <div class="metric-icon"><i class="bi bi-check2-square"></i></div>
        <div>
          <span class="metric-label">Tarefas cadastradas</span>
          <strong><%= stats.total_tarefas %></strong>
        </div>
      </article>

      <article class="metric-card">
        <div class="metric-icon"><i class="bi bi-bar-chart-fill"></i></div>
        <div>
          <span class="metric-label">Conclusão de tarefas</span>
          <strong><%= stats.taxa_conclusao %>%</strong>
        </div>
      </article>
    </section>

    <section class="dashboard-grid">
      <article class="panel-card">
        <header class="panel-header">
          <div>
            <h2>Usuários recentes</h2>
            <p>Últimas contas criadas na plataforma.</p>
          </div>
          <a class="text-link" href="/admin/usuarios">Ver todos <i class="bi bi-arrow-right"></i></a>
        </header>

        <% if (!usuariosRecentes.length) { %>
          <div class="empty-state">
            <i class="bi bi-people"></i>
            <strong>Nenhum usuário cadastrado</strong>
            <span>Quando novas contas forem criadas, elas aparecerão aqui.</span>
          </div>
        <% } else { %>
          <div class="user-list">
            <% usuariosRecentes.forEach((usuario) => {
              const inicial = usuario.nome ? usuario.nome.charAt(0).toUpperCase() : "?";
              const data = usuario.criado_em
                ? new Date(usuario.criado_em).toLocaleDateString("pt-BR")
                : "—";
            %>
              <a class="user-row" href="/admin/usuario/<%= usuario.id %>">
                <% if (usuario.foto_perfil) { %>
                  <img class="avatar" src="<%= usuario.foto_perfil %>" alt="" />
                <% } else { %>
                  <span class="avatar avatar-inicial"><%= inicial %></span>
                <% } %>

                <span class="user-row-info">
                  <strong><%= usuario.nome %></strong>
                  <small>@<%= usuario.nomeusuario || "sem usuário" %></small>
                </span>

                <time datetime="<%= usuario.criado_em ? new Date(usuario.criado_em).toISOString() : '' %>">
                  <%= data %>
                </time>

                <i class="bi bi-chevron-right"></i>
              </a>
            <% }) %>
          </div>
        <% } %>
      </article>

      <aside class="panel-card support-summary">
        <header class="panel-header">
          <div>
            <h2>Suporte</h2>
            <p>Solicitações que precisam de atenção.</p>
          </div>
          <a class="icon-link" href="/admin/suporte" aria-label="Abrir suporte">
            <i class="bi bi-arrow-up-right"></i>
          </a>
        </header>

        <div class="support-main">
          <span class="support-number"><%= suporteStats.pendentes %></span>
          <span>solicitações pendentes</span>
        </div>

        <div class="support-status">
          <div>
            <span class="status-dot pendente"></span>
            <span>Pendentes</span>
            <strong><%= suporteStats.pendentes %></strong>
          </div>
          <div>
            <span class="status-dot respondido"></span>
            <span>Respondidos</span>
            <strong><%= suporteStats.respondidos %></strong>
          </div>
          <div>
            <span class="status-dot resolvido"></span>
            <span>Resolvidos</span>
            <strong><%= suporteStats.resolvidos %></strong>
          </div>
        </div>
      </aside>
    </section>
  </main>

  <%- include('../../partials/footer.ejs') %>
</body>
</html>
