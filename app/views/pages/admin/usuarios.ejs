<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Usuários — Admin Healthy Safely</title>
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/admin/usuarios.css" />
  <link rel="stylesheet" href="/css/global.css" />
</head>

<body>
  <%- include('../../partials/admin-header.ejs', { activePage: 'usuarios' }) %>

  <main class="admin-main">
    <header class="page-heading">
      <div>
        <span class="eyebrow">Gerenciamento</span>
        <h1>Usuários</h1>
        <p>Consulte as contas cadastradas e acesse seus detalhes administrativos.</p>
      </div>
      <span class="total-count"><%= total %> usuário(s)</span>
    </header>

    <section class="panel-card">
      <header class="toolbar">
        <form class="search-form" method="GET" action="/admin/usuarios">
          <i class="bi bi-search"></i>
          <input
            type="search"
            name="busca"
            value="<%= busca %>"
            placeholder="Buscar por nome, usuário ou e-mail"
            autocomplete="off"
          />
          <% if (porPagina !== 15) { %>
            <input type="hidden" name="porPagina" value="<%= porPagina %>" />
          <% } %>
          <button type="submit">Buscar</button>
        </form>

        <% if (busca) { %>
          <a class="clear-link" href="/admin/usuarios">Limpar busca</a>
        <% } %>
      </header>

      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>Usuário</th>
              <th>E-mail</th>
              <th>Cadastro</th>
              <th>Onboarding</th>
              <th class="align-right">Ação</th>
            </tr>
          </thead>

          <tbody>
            <% if (!usuarios.length) { %>
              <tr>
                <td colspan="5">
                  <div class="empty-state">
                    <i class="bi bi-person-x"></i>
                    <strong>Nenhum usuário encontrado</strong>
                    <span><%= busca ? "Tente outro termo de busca." : "Ainda não existem usuários cadastrados." %></span>
                  </div>
                </td>
              </tr>
            <% } %>

            <% usuarios.forEach((usuario) => {
              const inicial = usuario.nome ? usuario.nome.charAt(0).toUpperCase() : "?";
              const criacao = usuario.criado_em
                ? new Date(usuario.criado_em).toLocaleDateString("pt-BR")
                : "—";
              const concluidas = Number(usuario.tarefas_concluidas || 0);
              const totalTarefas = Number(usuario.total_tarefas || 0);
            %>
              <tr>
                <td>
                  <a class="user-cell" href="/admin/usuario/<%= usuario.id %>">
                    <% if (usuario.foto_perfil) { %>
                      <img class="avatar" src="<%= usuario.foto_perfil %>" alt="" />
                    <% } else { %>
                      <span class="avatar avatar-inicial"><%= inicial %></span>
                    <% } %>
                    <span>
                      <strong><%= usuario.nome %></strong>
                      <small>@<%= usuario.nomeusuario || "sem usuário" %></small>
                    </span>
                  </a>
                </td>

                <td class="email-cell"><%= usuario.email %></td>

                <td class="muted-cell"><%= criacao %></td>

                <td>
                  <span class="status-pill <%= usuario.onboarding_concluido ? 'ok' : 'pendente' %>">
                    <%= usuario.onboarding_concluido ? "Concluído" : "Pendente" %>
                  </span>
                  <small class="task-count"><%= concluidas %>/<%= totalTarefas %> tarefas</small>
                </td>

                <td class="align-right">
                  <a class="view-button" href="/admin/usuario/<%= usuario.id %>">
                    Ver detalhes
                    <i class="bi bi-arrow-right"></i>
                  </a>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <% if (usuarios.length) { %>
        <footer class="table-footer">
          <span>
            Mostrando <strong><%= ((pagina - 1) * porPagina) + 1 %>–<%= Math.min(pagina * porPagina, total) %></strong>
            de <strong><%= total %></strong>
          </span>

          <nav class="pagination" aria-label="Paginação de usuários">
            <% if (pagina > 1) { %>
              <a href="/admin/usuarios?pagina=<%= pagina - 1 %>&porPagina=<%= porPagina %><%= busca ? '&busca=' + encodeURIComponent(busca) : '' %>" aria-label="Página anterior">
                <i class="bi bi-chevron-left"></i>
              </a>
            <% } else { %>
              <span class="disabled"><i class="bi bi-chevron-left"></i></span>
            <% } %>

            <span class="current"><%= pagina %> / <%= totalPaginas %></span>

            <% if (pagina < totalPaginas) { %>
              <a href="/admin/usuarios?pagina=<%= pagina + 1 %>&porPagina=<%= porPagina %><%= busca ? '&busca=' + encodeURIComponent(busca) : '' %>" aria-label="Próxima página">
                <i class="bi bi-chevron-right"></i>
              </a>
            <% } else { %>
              <span class="disabled"><i class="bi bi-chevron-right"></i></span>
            <% } %>
          </nav>
        </footer>
      <% } %>
    </section>
  </main>

  <%- include('../../partials/footer.ejs') %>
</body>
</html>
