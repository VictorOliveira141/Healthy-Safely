<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Suporte — Admin Healthy Safely</title>
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/admin/suporte.css" />
  <link rel="stylesheet" href="/css/global.css" />
</head>

<body>
  <%- include('../../partials/admin-header.ejs', { activePage: 'suporte' }) %>

  <main class="admin-main">
    <header class="page-heading">
      <div>
        <span class="eyebrow">Atendimento</span>
        <h1>Suporte</h1>
        <p>Gerencie as solicitações enviadas pelos usuários.</p>
      </div>
    </header>

    <section class="support-metrics">
      <a href="/admin/suporte" class="support-metric <%= !filtroStatus ? 'ativo' : '' %>">
        <span>Total</span>
        <strong><%= stats.total %></strong>
      </a>
      <a href="/admin/suporte?status=pendente" class="support-metric <%= filtroStatus === 'pendente' ? 'ativo' : '' %>">
        <span>Pendentes</span>
        <strong><%= stats.pendentes %></strong>
      </a>
      <a href="/admin/suporte?status=respondido" class="support-metric <%= filtroStatus === 'respondido' ? 'ativo' : '' %>">
        <span>Respondidos</span>
        <strong><%= stats.respondidos %></strong>
      </a>
      <a href="/admin/suporte?status=resolvido" class="support-metric <%= filtroStatus === 'resolvido' ? 'ativo' : '' %>">
        <span>Resolvidos</span>
        <strong><%= stats.resolvidos %></strong>
      </a>
    </section>

    <section class="requests">
      <% if (!suporte.length) { %>
        <div class="empty-state">
          <i class="bi bi-inbox"></i>
          <strong>Nenhuma solicitação encontrada</strong>
          <span>
            <%= filtroStatus ? "Não existem solicitações com esse status." : "Quando um usuário enviar uma mensagem pelo suporte, ela aparecerá aqui." %>
          </span>
        </div>
      <% } %>

      <% suporte.forEach((item) => { %>
        <article class="request-card">
          <header class="request-header">
            <div>
              <div class="request-title">
                <span class="request-id">#<%= item.id %></span>
                <h2><%= item.tipo %></h2>
              </div>
              <p class="request-meta">
                <strong><%= item.nome %></strong>
                · <%= item.email %>
                · <%= item.criado_em ? new Date(item.criado_em).toLocaleString("pt-BR") : "—" %>
              </p>
            </div>

            <span class="status <%= item.status %>"><%= item.status %></span>
          </header>

          <div class="request-body">
            <p><%= item.mensagem %></p>

            <% if (item.resposta) { %>
              <div class="reply">
                <span class="reply-label"><i class="bi bi-reply-fill"></i> Resposta enviada</span>
                <p><%= item.resposta %></p>
                <% if (item.respondido_em) { %>
                  <small><%= new Date(item.respondido_em).toLocaleString("pt-BR") %></small>
                <% } %>
              </div>
            <% } %>
          </div>

          <footer class="request-actions">
            <% if (item.status !== 'resolvido') { %>
              <button
                class="secondary-button"
                type="button"
                data-open-reply
                data-id="<%= item.id %>"
                data-name="<%= item.nome %>"
                data-message="<%= item.mensagem %>"
              >
                <i class="bi bi-reply"></i>
                <%= item.resposta ? "Editar resposta" : "Responder" %>
              </button>
            <% } %>

            <form action="/admin/suporte/<%= item.id %>/status" method="POST" class="status-form">
              <label for="status-<%= item.id %>">Status</label>
              <select id="status-<%= item.id %>" name="status" onchange="this.form.submit()">
                <option value="pendente" <%= item.status === "pendente" ? "selected" : "" %>>Pendente</option>
                <option value="respondido" <%= item.status === "respondido" ? "selected" : "" %>>Respondido</option>
                <option value="resolvido" <%= item.status === "resolvido" ? "selected" : "" %>>Resolvido</option>
              </select>
            </form>
          </footer>
        </article>
      <% }) %>
    </section>
  </main>

  <div class="modal" id="replyModal" aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="replyTitle">
      <header class="modal-header">
        <div>
          <span class="eyebrow">Atendimento</span>
          <h2 id="replyTitle">Responder solicitação</h2>
        </div>
        <button type="button" class="close-button" data-close-reply aria-label="Fechar">
          <i class="bi bi-x-lg"></i>
        </button>
      </header>

      <div class="original-message">
        <strong id="replyUser"></strong>
        <p id="replyMessage"></p>
      </div>

      <form id="replyForm" method="POST">
        <label for="resposta">Resposta</label>
        <textarea
          id="resposta"
          name="resposta"
          rows="6"
          maxlength="3000"
          required
          placeholder="Escreva uma resposta clara e objetiva..."
        ></textarea>

        <div class="modal-actions">
          <button type="button" class="cancel-button" data-close-reply>Cancelar</button>
          <button type="submit" class="primary-button">
            <i class="bi bi-send"></i>
            Enviar resposta
          </button>
        </div>
      </form>
    </div>
  </div>

  <script>
    const modal = document.getElementById("replyModal");
    const replyForm = document.getElementById("replyForm");
    const replyUser = document.getElementById("replyUser");
    const replyMessage = document.getElementById("replyMessage");
    const resposta = document.getElementById("resposta");

    function abrirResposta(button) {
      const id = button.dataset.id;

      replyForm.action = `/admin/suporte/${id}/responder`;
      replyUser.textContent = button.dataset.name || "Usuário";
      replyMessage.textContent = button.dataset.message || "";
      resposta.value = "";

      modal.classList.add("aberto");
      modal.setAttribute("aria-hidden", "false");
      setTimeout(() => resposta.focus(), 0);
    }

    function fecharResposta() {
      modal.classList.remove("aberto");
      modal.setAttribute("aria-hidden", "true");
    }

    document.querySelectorAll("[data-open-reply]").forEach((button) => {
      button.addEventListener("click", () => abrirResposta(button));
    });

    document.querySelectorAll("[data-close-reply]").forEach((button) => {
      button.addEventListener("click", fecharResposta);
    });

    modal.addEventListener("click", (event) => {
      if (event.target === modal) fecharResposta();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && modal.classList.contains("aberto")) {
        fecharResposta();
      }
    });
  </script>

  <%- include('../../partials/footer.ejs') %>
</body>
</html>
