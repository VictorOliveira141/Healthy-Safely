<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
  <title>
    <%= dados.possuiConta ? "Confirmar Login" : "Concluir Cadastro" %> | Healthy Safely
  </title>
  <link rel="stylesheet" href="/css/global.css" />
  <link rel="stylesheet" href="/css/auth/cadastro.css" />
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
    rel="stylesheet"
  />

  <link rel="manifest" href="/manifest.json" />
  <meta name="theme-color" content="#5BBF6A" />
</head>
a
<body>
    <%- include('../../partials/header.ejs') %>
   <main class="main google-confirmacao">
    <section class="card">
        <section class="form-area">
            <% const avatarGoogle = dados.foto_perfil || (usuario && usuario.foto_perfil) || '/imagem/user.webp'; %>
            <!-- VINDO PELA PAGINA DE login-->
            <% if (dados.possuiConta) { %>
                <h1 class="form-title">
                    Confirmar acesso
                </h1>
                
                <p style="font-size: 1rem;">
                    Você está entrando com a conta abaixo:
                </p>
                
                <div class="google-card">
                    <img
                        src="<%= avatarGoogle %>"
                        class="google-avatar"
                        alt="Foto do Google"
                        onerror="this.onerror=null;this.src='/imagem/user.webp';"
                    />
                        
                        <div class="google-user-info">
                            <h2>
                                <%= dados.usuario.nome %>
                            </h2>
                            
                            <p>
                                <%= dados.email %>
                            </p>
                        </div>
                    </div>

                    
                    <article style="display: flex; flex-direction: row; gap: 15px;">
                    <form action="/google/confirmacao" method="POST">
                        <button
                        class="btn-primary"
                        type="submit">
                        Entrar
                        </button>
                    </form>

                    <form action="/google/cancelar" method="POST">
                        <button
                         class="btn-primary"
                         type="submit"
                         style="color: red;">
                         Cancelar
                        </button>
                    </form>
                    </article>
            

            <!-- Vindo pela pagina de cadastro-->
            <% } else { %>
                <h1 class="form-title">
                    Conclua seu cadastro
                </h1>
                <p class="small">
                    Encontramos sua conta Google.
                    Agora basta completar seu cadastro.
                </p>
                
                <img
                    src="<%= avatarGoogle %>"
                    class="google-avatar"
                    alt="Foto do Google"
                    onerror="this.onerror=null;this.src='/imagem/user.webp';"
                >
                    
                    <form
                    class="form-multistep"
                    action="/google/cadastro"
                    method="POST"
                    novalidate>

                    <section>
                        <label class="inputs">E-mail</label>

                        <input
                        type="email"
                        id="email"
                        value="<%= valores.email %>"
                        placeholder="Digite seu endereço de e-mail"
                        disabled>
                    </section>

                    <section>
                        <label class="inputs">Nome</label>
                        <input
                        name="nome"
                        id="nome"
                        type="text"
                        placeholder="Digite como você quer ser chamado"
                        value="<%= valores.nome.split(' ')[0] %>">
                        <span class="msg-erro">
                        <%= msgErro.nome || '' %>
                        </span>
                    </section>

                    <section>
                        <label class="inputs">
                            Nome de Usuário
                        </label>
            
                        <input
                        name="nomeusuario"
                        id="nomeusuario"
                        type="text"
                        placeholder="Escolha um nome de usuário"
                        value="<%= valores.nomeusuario %>">

                        <span class="msg-erro">
                            <%= msgErro.nomeusuario || '' %>
                        </span>
                    </section>
                    
                    <section>
                        <label class="inputs">
                            Senha
                        </label>

                        <section class="campo-senha">
                        <input
                        name="senha"
                        id="senha"
                        type="password"
                        placeholder="Crie uma senha">
                        <button
                    type="button"
                    class="btn-olho"
                    onclick="toggleSenha('senha')"
                    aria-label="Mostrar senha"
                  >
                    <i class="bi bi-eye-slash-fill"></i>
                  </button>

                        </section>
                        
                        <span class="msg-erro">
                            <%= msgErro.senha || '' %>
                        </span>
                        
                        
                    </section>
                    
                    <section>
                        <label class="inputs">
                            Confirmar senha
                        </label>

                        <section class="campo-senha">
                        <input
                        name="confirmarSenha"
                        id="confirmarSenha"
                        type="password"
                        placeholder="Confirme sua senha">
                        <button
                    type="button"
                    class="btn-olho"
                    onclick="toggleSenha('confirmarSenha')"
                    aria-label="Mostrar senha"
                  >
                    <i class="bi bi-eye-slash-fill"></i>
                  </button>
                </section>
                        <span class="msg-erro">
                            <%= msgErro.confirmarSenha || '' %>
                        </span>
                    </section>
                    
                    <% if (msgErro.geral) { %>
                        <div class="msg-erro">
                            <%= msgErro.geral %>
                        </div>
                        <% } %>
                        <div class="actions">
                            <button
                            class="btn-primary"
                            type="submit">
                            Criar conta
                        </button>
                     </div>
                    </form>
                    <% } %>
                </section>
            </section>
        </main>
        
        <%- include('../../partials/footer.ejs') %>
        <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
        <script src="/js/auth/google-confirmacao.js"></script>
        <script src="/js/auth/ver-senha.js"></script>
</body>
</html>