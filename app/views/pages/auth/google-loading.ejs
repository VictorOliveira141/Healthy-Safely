<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
    <title>Conectando ao Google...</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
        font-family: Arial, Helvetica, sans-serif;
      }

      body {
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        background: var(--primary-color);
      }
      .container {
        color: var(--fundoclaro);
        width: 380px;
        padding: 45px 35px;
        border-radius: 16px;
        text-align: center;
        box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
        animation: aparecer 0.4s ease;
      }
      .google-logo {
        width: 70px;
        margin-bottom: 25px;
      }
      h2 {
        font-size: 22px;
        margin-bottom: 12px;
        font-weight: 600;
      }

      p {
        font-size: 15px;
        line-height: 1.5;
        margin-bottom: 30px;
      }

      .loader {
        width: 45px;
        height: 45px;
        border: 4px solid #e0e0e0;
        border-top: 4px solid #4285f4;
        border-radius: 50%;
        margin: auto;
        animation: girar 1s linear infinite;
      }

      @keyframes girar {
        from {
          transform: rotate(0deg);
        }

        to {
          transform: rotate(360deg);
        }
      }

      @keyframes aparecer {
        from {
          opacity: 0;
          transform: translateY(15px);
        }

        to {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .security {
        margin-top: 30px;
        font-size: 12px;
        color: #80868b;
      }
    </style>

    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#5BBF6A" />
  </head>

  <body>
    <div class="container">
      <img
        class="google-logo"
        src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg"
        alt="Google"
      />
      <h2>Conectando sua conta</h2>
      <p>
        Estamos verificando suas informações do Google. Aguarde alguns
        segundos...
      </p>
      <div class="loader"></div>
      <div class="security">🔒 Conexão segura pelo Google</div>
    </div>

    <script src="../../js/navegacao/darkmode.js"></script>
    <script>
      const redirectUrl = "/google/confirmacao";
      const fallbackUrl = "/login";

      const goToNextStep = () => {
        window.location.replace(redirectUrl);
      };

      window.addEventListener("pageshow", () => {
        setTimeout(() => {
          if (document.visibilityState === "hidden") {
            window.location.assign(redirectUrl);
            return;
          }

          goToNextStep();
        }, 1500);
      });

      window.addEventListener("error", () => {
        window.location.assign(fallbackUrl);
      });
    </script>
  </body>
</html>
