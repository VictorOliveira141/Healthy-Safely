<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Criar Conta | Healthy Safely</title>
    <meta property="og:title" content="Criar Conta | Healthy Safely" />
    <meta
      property="og:description"
      content="Abra sua conta no Healthy Safely e comece a acompanhar sua saúde hoje mesmo."
    />
    <meta property="og:image" content="/imagem/Logo repaginado 2.webp" />
    <meta
      property="og:url"
      content="https://healthysafely.com/cadastroCliente"
    />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Healthy Safely" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/cadastro.css" />
    <link rel="icon" href="/imagem/Logo repaginado 2.webp" />
  </head>

  <body>
    <%
      const valoresForm = typeof valores !== 'undefined' ? valores : {};
      const erroValidacaoForm = typeof erroValidacao !== 'undefined' ? erroValidacao : {};
      const msgErroForm = typeof msgErro !== 'undefined' ? msgErro : {};
    %>
    <%- include('../partials/header.ejs') %>

    <main class="main">
      <section class="card" aria-labelledby="titulo-cadastro">
        <section class="form-area">
          <h1 id="titulo-cadastro" class="form-title">
            Cadastra-se e comece a cuidar da sua saúde!
          </h1>

          <div class="step-indicator" aria-label="Progresso do cadastro">
            <div class="step-indicator__bar">
              <div class="step-indicator__fill"></div>
            </div>
            <div class="step-indicator__labels">
              <span class="step-label active" data-step="1">1. E-mail</span>
              <span class="step-label" data-step="2">2. Senha</span>
              <span class="step-label" data-step="3">3. Usuário</span>
            </div>
          </div>

          <form
            class="form-multistep"
            action="/cadastroCliente"
            method="POST"
            novalidate
          >
            <section class="step-panel active" data-step="1">
              <article class="form-group">
                <label for="email" class="inputs">E-mail</label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  placeholder="Digite seu endereço de e-mail"
                  value="<%= valoresForm.email || '' %>"
                  class="<%= erroValidacaoForm.email ? 'erro-input' : '' %>"
                  autocomplete="email"
                  required
                />
                <span class="msg-erro"
                  ><%= msgErroForm.email || '' %></span
                >
              </article>

              <article class="actions">
                <button class="btn-primary" type="button" data-action="next">
                  Próximo
                </button>
              </article>
            </section>

            <section class="step-panel" data-step="2">
              <article class="form-group">
                <label for="senha" class="inputs">Senha</label>
                <article class="campo-senha">
                  <input
                    id="senha"
                    name="senha"
                    type="password"
                    placeholder="Crie uma senha"
                    class="<%= erroValidacaoForm.senha ? 'erro-input' : '' %>"
                    autocomplete="new-password"
                    required
                  />
                  <button
                    type="button"
                    class="btn-olho"
                    onclick="toggleSenha('senha')"
                    aria-label="Mostrar senha"
                  >
                    <i class="bi bi-eye-slash-fill"></i>
                  </button>
                </article>
                <span class="msg-erro"
                  ><%= msgErroForm.senha || '' %></span
                >
              </article>

              <article class="form-group">
                <label for="confirmarSenha" class="inputs"
                  >Confirmar Senha</label
                >
                <article class="campo-senha">
                  <input
                    id="confirmarSenha"
                    name="confirmarSenha"
                    type="password"
                    placeholder="Confirme sua senha"
                    class="<%= erroValidacaoForm.confirmarSenha ? 'erro-input' : '' %>"
                    autocomplete="new-password"
                    required
                  />
                  <button
                    type="button"
                    class="btn-olho"
                    onclick="toggleSenha('confirmarSenha')"
                    aria-label="Mostrar senha"
                  >
                    <i class="bi bi-eye-slash-fill"></i>
                  </button>
                </article>
                <span class="msg-erro"
                  ><%= msgErroForm.confirmarSenha || '' %></span
                >
              </article>

              <article class="actions actions-duplo">
                <button class="btn-secondary" type="button" data-action="back">
                  <i data-lucide="ArrowLeft" aria-hidden="true"></i>
                </button>
                <button class="btn-primary" type="button" data-action="next">
                  Próximo
                </button>
              </article>
            </section>

            <section class="step-panel" data-step="3">
              <article class="form-group">
                <label for="nome" class="inputs">Nome</label>
                <input
                  id="nome"
                  name="nome"
                  type="text"
                  placeholder="Digite como você quer ser chamado"
                  value="<%= valoresForm.nome || '' %>"
                  class="<%= erroValidacaoForm.nome ? 'erro-input' : '' %>"
                  autocomplete="name"
                  required
                />
                <span class="msg-erro"
                  ><%= msgErroForm.nome || '' %></span
                >
              </article>

              <article class="form-group">
                <label for="nomeusuario" class="inputs">Nome de Usuário</label>
                <input
                  id="nomeusuario"
                  name="nomeusuario"
                  type="text"
                  placeholder="Escolha um nome de usuário"
                  value="<%= valoresForm.nomeusuario || '' %>"
                  class="<%= erroValidacaoForm.nomeusuario ? 'erro-input' : '' %>"
                  autocomplete="username"
                  required
                />
                <span class="msg-erro"
                  ><%= msgErroForm.nomeusuario || '' %></span
                >
              </article>

              <div class="form-loading" aria-live="polite">
                <div class="spinner"></div>
                <span>Criando sua conta...</span>
              </div>

              <article class="actions actions-duplo">
                <button class="btn-secondary" type="button" data-action="back">
                  <i data-lucide="ArrowLeft" aria-hidden="true"></i>
                </button>
                <button class="btn-primary" type="submit">Criar</button>
              </article>
            </section>

            <p class="or" aria-hidden="true">ou</p>

            <a
              class="btn-google"
              href="/auth/google"
              role="button"
              aria-label="Cadastrar com Google"
            >
              <i class="bi bi-google"></i>
              <p>Continuar com Google</p>
            </a>
          </form>
        </section>
      </section>
    </main>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="/js/validacao-front-end.js"></script>
    <script src="/js/cadastro-multistep.js"></script>
    <script src="/js/ver-senha.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
      lucide.createIcons();
    </script>
  </body>
</html>
